---
import "../styles/global.css";
import Header from "../components/Header.astro";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
	title?: string;
	description?: string;
	/** Ścieżka do obrazu OG (1200×630). Domyślnie globalny. */
	ogImage?: string;
	/** Wyłącz indeksowanie (strony robocze, podglądy). */
	noindex?: boolean;
	/** Ukryj globalny header (np. dla ekranów powitalnych). */
	hideHeader?: boolean;
}

const {
	title = "FilarAI - System, strony, SEO",
	description = "Buduję strony WWW, systemy AI i SEO/GEO dla małych firm. Konkret zamiast obietnic — pierwsza rozmowa bez zobowiązań, odpowiadam w 15 minut.",
	ogImage = "/og-default.png",
	noindex = false,
	hideHeader = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://filarai.com");
const ogImageUrl = new URL(ogImage, Astro.site ?? "https://filarai.com");
---

<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph — bez tego link wrzucony na WhatsAppa/Facebooka to goły URL bez podglądu -->
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:site_name" content="FilarAI" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" media="(prefers-color-scheme: light)" />
		<link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />

		<!-- Synonym (fontshare) — zastąpił Geist + Inter -->
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link
			rel="stylesheet"
			href="https://api.fontshare.com/v2/css?f[]=synonym@400,500,600,700&display=swap"
		/>
	</head>
	<body>
		<a href="#main" class="sr-only">Przejdź do treści</a>
		{!hideHeader && <Header />}
		<slot />
		<CookieBanner />
		<script is:inline>
			(() => {
				let marqueeTimer = null;
				let originalTitle = document.title;
				const alertText = "⚠️ TĘSKNIMY    ";

				const getGraphemes = (str) => {
					if (typeof Intl !== "undefined" && Intl.Segmenter) {
						return Array.from(
							new Intl.Segmenter("pl", { granularity: "grapheme" }).segment(str),
							(s) => s.segment
						);
					}
					return [...str];
				};

				const startMarquee = () => {
					if (marqueeTimer) return;
					originalTitle = document.title;
					let chars = getGraphemes(alertText);
					marqueeTimer = setInterval(() => {
						chars.push(chars.shift());
						document.title = chars.join("");
					}, 300);
				};

				const stopMarquee = () => {
					if (marqueeTimer) {
						clearInterval(marqueeTimer);
						marqueeTimer = null;
					}
					if (originalTitle) {
						document.title = originalTitle;
					}
				};

				document.addEventListener("visibilitychange", () => {
					if (document.hidden) {
						startMarquee();
					} else {
						stopMarquee();
					}
				});

				window.addEventListener("pagehide", stopMarquee);
				window.addEventListener("beforeunload", stopMarquee);
			})();
		</script>
	</body>
</html>
