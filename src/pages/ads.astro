---
import Layout from "../layouts/Layout.astro";
import WkrotcePlaceholder from "../components/WkrotcePlaceholder.astro";
import Footer from "../components/Footer.astro";

const links = [
	{
		label: "Strony WWW",
		desc: "Szybkie strony nastawione na zapytania od klientów.",
		href: "/strony",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><circle cx="6.5" cy="6.5" r="0.7" fill="currentColor" stroke="none"/><circle cx="9" cy="6.5" r="0.7" fill="currentColor" stroke="none"/></svg>`,
	},
	{
		label: "Systemy AI",
		desc: "Automatyzacje, które odbierają kontakt i pilnują follow-upu.",
		href: "/systemy",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="6" r="2"/><circle cx="5" cy="18" r="2"/><circle cx="18" cy="12" r="2"/><path d="M7 6.6h3.5a4 4 0 0 1 4 4v0M7 17.4h3.5a4 4 0 0 0 4-4v0"/></svg>`,
	},
	{
		label: "Portfolio",
		desc: "Realizacje, które już działają u klientów.",
		href: "/portfolio",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 14l4-4 5 5 3-3 6 6"/></svg>`,
	},
];
---

<Layout title="Meta Ads — FilarAI">
	<main id="main">
		<WkrotcePlaceholder
			title="Meta Ads"
			subtitle="Ten obszar startuje wkrótce."
			desc="Kampanie na Facebooku i Instagramie, które przynoszą realne zapytania. Jeszcze nie ma tego w ofercie, ale niedługo ruszam. Napisz, jeśli chcesz być pierwszy w kolejce na warunki startowe."
			links={links}
		/>
	</main>
	<Footer />
</Layout>
