---
// Konsultacje — najniższy próg wejścia w ofercie. Strona sprzedaje ROZMOWĘ, nie usługę:
// pierwsza jest darmowa, potem płacisz za konkret. Wyróżnik: raport po sesji.
//
// Sekcje inline (jedno miejsce użycia). Reuse: Cta, Footer. Ceny i treści ROBOCZE.

import Layout from "../layouts/Layout.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";

// TODO: podmienić na realny link do kalendarza (Calendly / Cal.com).
// Do tego czasu prowadzi na /kontakt, żeby nie shipować martwego przycisku.
const KALENDARZ_URL = "/kontakt";

// Wywnioskowany z tel:+48534458418 w Kontakt/Footer — do potwierdzenia przez Kacpra.
const WHATSAPP_URL = "https://wa.me/48534458418?text=Cze%C5%9B%C4%87%2C%20chc%C4%99%20um%C3%B3wi%C4%87%20konsultacj%C4%99";

const obszary = [
	{
		nr: "01",
		tytul: "Audyt: co zautomatyzować",
		opis: "Przechodzimy przez to, co robisz ręcznie, i wskazuję procesy, które może przejąć system. Z szacunkiem, ile czasu to odda.",
		dlaKogo: "Dla firm, które toną w powtarzalnej robocie",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M8 11h6M11 8v6"/></svg>`,
	},
	{
		nr: "02",
		tytul: "Strategia obecności online",
		opis: "Co robić najpierw, a czego nie robić wcale. Strona, SEO, kanały pozyskiwania klientów, ułożone w kolejność zamiast listy życzeń.",
		dlaKogo: "Dla firm, które nie wiedzą, od czego zacząć",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18l5-5 4 4 7-8"/><path d="M14 9h6v6"/></svg>`,
	},
	{
		nr: "03",
		tytul: "Konsultacja techniczna",
		opis: "Masz stronę albo system i coś nie działa tak, jak powinno. Druga para oczu: co poprawić, dlaczego to nie konwertuje, jak rozbudować.",
		dlaKogo: "Dla firm, które już coś mają",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4.5a4 4 0 0 0 5 5L21 8v8a2 2 0 0 1-2 2H8l-1.5 1.5a4 4 0 0 1-5-5L3 13"/><path d="M3 3l18 18"/></svg>`,
	},
	{
		nr: "04",
		tytul: "Szkolenie z AI dla zespołu",
		opis: "Pokazuję, jak używać narzędzi AI w codziennej pracy: oferty, maile, teksty, obsługa klienta. Na Waszych realnych zadaniach, nie na przykładach z internetu.",
		dlaKogo: "Dla zespołów, które chcą pracować szybciej",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 19c.6-3 2.9-4.5 6-4.5s5.4 1.5 6 4.5"/><path d="M17 8h5M19.5 5.5v5"/></svg>`,
	},
];

const kroki = [
	{ nr: "01", tytul: "Rozmowa wstępna", czas: "30 min · 0 zł", opis: "Opowiadasz, co Cię męczy. Mówię, czy umiem pomóc i czy w ogóle warto." },
	{ nr: "02", tytul: "Sesja", czas: "online lub u Ciebie", opis: "Wchodzimy w szczegóły. Analizujemy procesy, narzędzia i to, co realnie blokuje." },
	{ nr: "03", tytul: "Raport", czas: "do 3 dni po sesji", opis: "Dostajesz pisemne podsumowanie: co robić, w jakiej kolejności, ile to kosztuje.", wyroznik: true },
	{ nr: "04", tytul: "Decyzja", czas: "bez presji", opis: "Wdrażasz sam, zlecasz mnie albo odkładasz. Raport zostaje Twój niezależnie od wyboru." },
];

const platne = [
	{
		nazwa: "Konsultacja online",
		cena: "400",
		jednostka: "zł / 90 min",
		punkty: ["Wideorozmowa", "Raport z rekomendacjami", "Odpowiedzi na pytania przez tydzień po sesji"],
		featured: true,
	},
	{
		nazwa: "Konsultacja u Ciebie",
		cena: "od 700",
		jednostka: "zł",
		punkty: ["Spotkanie w Twojej firmie", "Raport z rekomendacjami", "Dojazd w cenie do 100 km"],
	},
	{
		nazwa: "Pakiet 3 sesji",
		cena: "1 000",
		jednostka: "zł",
		punkty: ["Trzy sesje rozłożone w czasie", "Wdrażanie między spotkaniami", "Raport po każdej sesji"],
	},
];

const pasuje = [
	"Masz konkretny problem i chcesz wiedzieć, czy da się go rozwiązać",
	"Wolisz zapłacić za godzinę rozmowy niż za miesiąc błędnych decyzji",
	"Chcesz zrozumieć, co kupujesz, zanim to zamówisz",
];

const niePasuje = [
	"Szukasz darmowej roboty pod pozorem rozmowy",
	"Decyzję i tak podejmie ktoś, kogo nie będzie na spotkaniu",
];
---

<Layout
	title="Konsultacje — audyt, strategia i szkolenia AI | FilarAI"
	description="Pierwsza rozmowa bez opłat. Audyt automatyzacji, strategia obecności online, konsultacje techniczne i szkolenia AI dla zespołu. Po sesji dostajesz pisemny raport."
>
	<main id="main">
		<section class="kons-hero section--atmosphere">
			<div class="kons-hero__outer">
				<div class="kons-hero__copy">
					<p class="kons-hero__eyebrow"><i aria-hidden="true"></i><b>Konsultacje</b><span>/</span> audyt i strategia</p>
					<h1 class="kons-hero__title">Zanim cokolwiek zbudujemy,<span>sprawdźmy, czy warto.</span></h1>
					<p class="kons-hero__lead">
						Pierwsza rozmowa nic nie kosztuje i do niczego nie zobowiązuje. Jeśli uznam, że nie
						umiem pomóc albo że problem da się rozwiązać taniej, powiem to wprost.
					</p>
					<div class="kons-hero__actions">
						<a href={WHATSAPP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Napisz na WhatsApp <span aria-hidden="true">→</span></a>
						<a href={KALENDARZ_URL} class="btn btn--secondary">Zarezerwuj termin</a>
					</div>
				</div>

				<div class="kons-hero__card">
					<p class="kons-hero__card-label">Co ustalimy w 30 minut</p>
					<ul class="kons-hero__card-list">
						<li>Gdzie realnie tracisz czas albo klientów</li>
						<li>Co da się naprawić od ręki, a co wymaga projektu</li>
						<li>Ile to kosztuje i czy się zwróci</li>
						<li>Czy w ogóle jestem Ci potrzebny</li>
					</ul>
				</div>
			</div>
		</section>

		<section class="kons-obszary section--light">
			<div class="kons-obszary__outer">
				<div class="kons-obszary__head">
					<h2 class="kons-obszary__title">Cztery powody, żeby się odezwać.</h2>
					<p class="kons-obszary__lead">Nie musisz wiedzieć, czego dokładnie potrzebujesz. Od tego jest rozmowa.</p>
				</div>

				<ul class="kons-obszary__list">
					{
						obszary.map((o) => (
							<li class="kons-obsz">
								<span class="kons-obsz__nr" aria-hidden="true">{o.nr}</span>
								<span class="kons-obsz__icon" set:html={o.icon} />
								<div class="kons-obsz__body">
									<h3 class="kons-obsz__title">{o.tytul}</h3>
									<p class="kons-obsz__desc">{o.opis}</p>
								</div>
								<p class="kons-obsz__dla">{o.dlaKogo}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="kons-jak section--dark">
			<div class="kons-jak__outer">
				<div class="kons-jak__head">
					<h2 class="kons-jak__title">Rozmowa to nie wszystko. Zostaje dokument.</h2>
					<p class="kons-jak__lead">Większość konsultacji kończy się na miłej pogawędce, po której nic nie pamiętasz. U mnie po sesji dostajesz raport, z którym możesz pójść do kogokolwiek.</p>
				</div>

				<ol class="kons-jak__kroki">
					{
						kroki.map((k) => (
							<li class:list={["kons-krok", k.wyroznik && "kons-krok--wyroznik"]}>
								<span class="kons-krok__nr" aria-hidden="true">{k.nr}</span>
								<h3 class="kons-krok__title">{k.tytul}</h3>
								<p class="kons-krok__czas">{k.czas}</p>
								<p class="kons-krok__desc">{k.opis}</p>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<section class="kons-cennik section--light">
			<div class="kons-cennik__outer">
				<div class="kons-cennik__head">
					<h2 class="kons-cennik__title">Pierwsza rozmowa za darmo. Reszta uczciwie.</h2>
					<p class="kons-cennik__lead">Płacisz za czas i za raport, nie za obietnice. Jeśli po konsultacji zdecydujesz się na projekt, koszt sesji odliczam od wyceny.</p>
				</div>

				<div class="kons-cennik__free">
					<div class="kons-cennik__free-copy">
						<p class="kons-cennik__free-label">Rozmowa wstępna</p>
						<p class="kons-cennik__free-desc">30 minut, online. Bez prezentacji sprzedażowej i bez zobowiązań.</p>
					</div>
					<p class="kons-cennik__free-price">0 <em>zł</em></p>
					<a href={WHATSAPP_URL} class="btn btn--primary" target="_blank" rel="noopener noreferrer">Umów bezpłatnie <span aria-hidden="true">→</span></a>
				</div>

				<ul class="kons-cennik__grid">
					{
						platne.map((p) => (
							<li class:list={["kons-pak", p.featured && "kons-pak--featured"]}>
								{p.featured && <span class="kons-pak__badge">Najczęściej wybierana</span>}
								<h3 class="kons-pak__name">{p.nazwa}</h3>
								<p class="kons-pak__price">{p.cena} <em>{p.jednostka}</em></p>
								<ul class="kons-pak__punkty">
									{p.punkty.map((t) => (
										<li>
											<span class="kons-pak__check" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4.5 4.5L19 7"/></svg></span>
											{t}
										</li>
									))}
								</ul>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="kons-sens section--atmosphere">
			<div class="kons-sens__outer">
				<div class="kons-sens__intro">
					<h2 class="kons-sens__title">Kiedy konsultacja ma sens.</h2>
					<p class="kons-sens__lead">Wolę powiedzieć to przed spotkaniem niż po nim.</p>
				</div>

				<div class="kons-sens__split">
					<div class="kons-sens__col">
						<h3 class="kons-sens__col-title">Pogadajmy, jeśli</h3>
						<ul class="kons-sens__list">
							{
								pasuje.map((t) => (
									<li>
										<span class="kons-sens__mark" aria-hidden="true">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l4.5 4.5L19 7"/></svg>
										</span>
										{t}
									</li>
								))
							}
						</ul>
					</div>

					<div class="kons-sens__col kons-sens__col--no">
						<h3 class="kons-sens__col-title">Odpuść sobie, jeśli</h3>
						<ul class="kons-sens__list">
							{
								niePasuje.map((t) => (
									<li>
										<span class="kons-sens__mark kons-sens__mark--muted" aria-hidden="true">
											<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><path d="M6 12h12"/></svg>
										</span>
										{t}
									</li>
								))
							}
						</ul>
					</div>
				</div>
			</div>
		</section>

		<section class="kons-rez section--light">
			<div class="kons-rez__outer">
				<h2 class="kons-rez__title">Wybierz, jak wolisz.</h2>
				<div class="kons-rez__grid">
					<a class="kons-rez__card" href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer">
						<span class="kons-rez__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.6 7.4L3 21l2.2-5.2A8.5 8.5 0 1 1 21 11.5z"/></svg>
						</span>
						<h3>WhatsApp</h3>
						<p>Najszybciej. Piszesz, odpowiadam zwykle w 15 minut.</p>
						<span class="kons-rez__link">Napisz wiadomość <i aria-hidden="true">→</i></span>
					</a>

					<a class="kons-rez__card" href={KALENDARZ_URL}>
						<span class="kons-rez__icon" aria-hidden="true">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="15" rx="2"/><path d="M4 10h16M8 3v4M16 3v4"/></svg>
						</span>
						<h3>Kalendarz</h3>
						<p>Wybierasz termin, który Ci pasuje. Bez ustalania przez wiadomości.</p>
						<span class="kons-rez__link">Zarezerwuj termin <i aria-hidden="true">→</i></span>
					</a>
				</div>
			</div>
		</section>

		<Cta />
	</main>
	<Footer />
</Layout>

<style>
	/* ===== Hero ===== */
	.kons-hero__outer {
		max-width: var(--size-container); margin-inline: auto;
		padding-inline: var(--container-padding); padding-block: var(--spacing-section) var(--spacing-4xl);
		display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		align-items: center; gap: var(--spacing-4xl);
	}
	.kons-hero__eyebrow {
		display: inline-flex; align-items: center; gap: 0.65em; font-size: 0.75em;
		font-weight: var(--weight-emphasis); letter-spacing: 2px; text-transform: uppercase; color: var(--color-text-secondary);
	}
	.kons-hero__eyebrow i { width: 0.55em; height: 0.55em; border-radius: 50%; background-color: var(--accent-brand); }
	.kons-hero__eyebrow b { color: var(--color-contrast); }
	.kons-hero__eyebrow > span { color: var(--accent-brand); }
	.kons-hero__title {
		margin-top: var(--spacing-lg); font-family: var(--font-heading); font-size: var(--text-h1);
		font-weight: var(--weight-heading); line-height: var(--lh-display); letter-spacing: -1.5px;
		color: var(--color-contrast); text-wrap: balance;
	}
	.kons-hero__title span { display: block; color: var(--accent-text); }
	.kons-hero__lead { margin-top: var(--spacing-lg); max-width: 34em; font-size: var(--text-lead); line-height: var(--lh-lead); color: var(--color-text-secondary); }
	.kons-hero__actions { display: flex; flex-wrap: wrap; gap: var(--spacing-md); margin-top: var(--spacing-xl); }

	.kons-hero__card {
		padding: var(--spacing-xl); border: 1px solid var(--color-border); border-radius: var(--radius-lg);
		background-color: var(--color-canvas); box-shadow: var(--elevation-2);
	}
	.kons-hero__card-label {
		font-size: 0.75em; font-weight: var(--weight-emphasis); letter-spacing: 1px;
		text-transform: uppercase; color: var(--color-text-muted);
	}
	.kons-hero__card-list { display: grid; gap: 0.75em; margin-top: var(--spacing-md); list-style: none; }
	.kons-hero__card-list li {
		position: relative; padding-left: 1.6em; font-size: var(--text-sm); line-height: 1.5; color: var(--color-contrast);
	}
	.kons-hero__card-list li::before {
		content: ""; position: absolute; left: 0; top: 0.45em;
		width: 0.5em; height: 0.5em; border-radius: 50%; background-color: var(--accent-brand);
	}

	/* ===== Cztery obszary ===== */
	.kons-obszary__outer {
		max-width: var(--size-container); margin-inline: auto;
		padding-inline: var(--container-padding); padding-block: var(--spacing-section);
	}
	.kons-obszary__head { max-width: 40em; margin-bottom: var(--spacing-2xl); }
	.kons-obszary__title {
		font-family: var(--font-heading); font-size: var(--text-h2); font-weight: var(--weight-heading);
		line-height: var(--lh-heading); letter-spacing: -1px; color: var(--color-contrast); text-wrap: balance;
	}
	.kons-obszary__lead { margin-top: var(--spacing-md); font-size: var(--text-lead); line-height: var(--lh-lead); color: var(--color-text-secondary); }

	.kons-obszary__list {
		list-style: none; border: 1px solid var(--color-border); border-radius: var(--radius-lg);
		background-color: var(--color-canvas); box-shadow: var(--elevation-1); padding-inline: var(--spacing-xl);
	}
	.kons-obsz {
		display: grid; grid-template-columns: 2.5em 3em minmax(0, 1fr) minmax(11em, 14em);
		align-items: center; gap: var(--spacing-lg); padding-block: var(--spacing-xl);
	}
	.kons-obsz + .kons-obsz { border-top: 1px solid var(--color-border); }
	.kons-obsz__nr { font-family: var(--font-heading); font-weight: var(--weight-heading); color: var(--accent-deep); font-variant-numeric: tabular-nums; }
	.kons-obsz__icon { display: inline-flex; align-items: center; justify-content: center; width: 3em; height: 3em; border-radius: var(--radius-md); background-color: var(--accent-wash); color: var(--accent-deep); }
	.kons-obsz__icon svg { width: 1.5em; height: 1.5em; }
	.kons-obsz__title { font-family: var(--font-heading); font-size: var(--text-h3); font-weight: var(--weight-heading); letter-spacing: -0.5px; color: var(--color-contrast); }
	.kons-obsz__desc { margin-top: 0.4em; font-size: var(--text-sm); line-height: 1.55; color: var(--color-text-secondary); max-width: 34em; }
	.kons-obsz__dla {
		padding: 0.5em 0.85em; border-radius: var(--radius-sm); background-color: var(--color-atmosphere);
		font-size: 0.75em; line-height: 1.4; color: var(--color-text-secondary); text-align: center;
	}

	/* ===== Jak wygląda (dark) ===== */
	.kons-jak { background-color: var(--color-atmosphere-dark); color: var(--color-text-on-dark); }
	.kons-jak__outer {
		max-width: var(--size-container); margin-inline: auto;
		padding-inline: var(--container-padding); padding-block: var(--spacing-section);
	}
	.kons-jak__head { max-width: 40em; margin-bottom: var(--spacing-3xl); }
	.kons-jak__title {
		font-family: var(--font-heading); font-size: var(--text-h2); font-weight: var(--weight-heading);
		line-height: var(--lh-heading); letter-spacing: -1px; color: var(--color-text-on-dark); text-wrap: balance;
	}
	.kons-jak__lead { margin-top: var(--spacing-md); font-size: var(--text-lead); line-height: 1.65; color: var(--color-text-on-dark-muted); }

	.kons-jak__kroki { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--spacing-lg); list-style: none; }
	.kons-krok {
		padding: var(--spacing-lg); border: 1px solid var(--color-border-on-dark); border-radius: var(--radius-md);
	}
	.kons-krok--wyroznik { border-color: var(--accent-brand); background-color: rgba(168, 196, 71, 0.08); }
	.kons-krok__nr { font-family: var(--font-heading); font-size: 0.75em; font-weight: var(--weight-heading); letter-spacing: 1px; color: var(--accent-brand); font-variant-numeric: tabular-nums; }
	.kons-krok__title { margin-top: 0.5em; font-family: var(--font-heading); font-size: 1.125em; font-weight: var(--weight-heading); color: var(--color-text-on-dark); }
	.kons-krok__czas { margin-top: 0.25em; font-size: 0.75em; font-weight: var(--weight-emphasis); color: var(--accent-brand); }
	.kons-krok__desc { margin-top: var(--spacing-sm); font-size: var(--text-sm); line-height: 1.55; color: var(--color-text-on-dark-muted); }

	/* ===== Cennik ===== */
	.kons-cennik__outer {
		max-width: var(--size-container); margin-inline: auto;
		padding-inline: var(--container-padding); padding-block: var(--spacing-section);
	}
	.kons-cennik__head { max-width: 42em; margin-bottom: var(--spacing-2xl); }
	.kons-cennik__title {
		font-family: var(--font-heading); font-size: var(--text-h2); font-weight: var(--weight-heading);
		line-height: var(--lh-heading); letter-spacing: -1px; color: var(--color-contrast); text-wrap: balance;
	}
