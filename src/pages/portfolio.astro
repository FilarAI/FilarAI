---
// Portfolio — indeks realizacji jako siatka kafli, w języku wizualnym kart ze strony
// głównej (numer + kategoria, klient, zakres, efekt jako badge).
//
// Kafle jadą z projekty.ts i PlytaRealizacji — tego samego źródła co case studies,
// więc obie strony nie mogą się rozjechać, a screeny podmienią się na obu naraz.
//
// Filtr: radio + kombinator `~`, bez grama JS.

import Layout from "../layouts/Layout.astro";
import Oferta from "../components/Oferta.astro";
import JakWygladaWspolpraca from "../components/JakWygladaWspolpraca.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import PlytaRealizacji from "../components/PlytaRealizacji.astro";
import { projekty, etykietyTypow, type Typ } from "../data/projekty";

// Renderujemy tylko kategorie, które mają min. 1 realizację — pusty stan nigdy nie
// powstaje, więc nie trzeba go projektować.
const kolejnoscTypow: Typ[] = ["strona", "seo", "system"];
const kategorie = kolejnoscTypow
	.map((typ) => ({ typ, ile: projekty.filter((p) => p.typ === typ).length }))
	.filter((k) => k.ile > 0);

const najstarszy = Math.min(...projekty.map((p) => p.rok));
const dwucyfrowo = (n: number) => String(n).padStart(2, "0");
---

<Layout
	title="Portfolio — realizacje | FilarAI"
	description="Strony WWW, systemy AI i SEO dla firm usługowych i produkcyjnych. Konkretne wdrożenia, konkretne efekty."
>
	<main id="main">
		<section class="pf-hero section--atmosphere">
			<div class="pf-hero__outer">
				<span class="pf-hero__corner pf-hero__corner--tl" aria-hidden="true"></span>
				<span class="pf-hero__corner pf-hero__corner--tr" aria-hidden="true"></span>
				<span class="pf-hero__corner pf-hero__corner--bl" aria-hidden="true"></span>
				<span class="pf-hero__corner pf-hero__corner--br" aria-hidden="true"></span>

				<p class="pf-hero__eyebrow"><i aria-hidden="true"></i><b>Portfolio</b><span>/</span> realizacje</p>

				<div class="pf-hero__split">
					<div class="pf-hero__copy">
						<h1 class="pf-hero__title">Konkretne firmy.<span>Konkretne wdrożenia.</span></h1>
						<p class="pf-hero__lead">
							Bez okrągłych zdań o „transformacji". Poniżej to, co zbudowałem, dla kogo
							i co się przez to zmieniło.
						</p>
					</div>

					{/* Szyna meta — celowo mała i techniczna. Duże cyfry z podpisami to
					    hero-metric template, którego nie tykamy. */}
					<dl class="pf-hero__rail">
						<div><dt>Realizacji</dt><dd>{dwucyfrowo(projekty.length)}</dd></div>
						<div><dt>Od</dt><dd>{najstarszy}</dd></div>
						<div><dt>Kategorie</dt><dd>{dwucyfrowo(kategorie.length)}</dd></div>
					</dl>
				</div>

				{/* Filtr w foldzie — strona zaczyna działać, zanim zescrollujesz.
				    Radia i siatka nie są rodzeństwem, więc filtruje `:has()`, nie `~`. */}
				<input type="radio" name="filtr" id="f-all" class="sr-only" checked />
				{kategorie.map((k) => <input type="radio" name="filtr" id={`f-${k.typ}`} class="sr-only" />)}

				<div class="pf-hero__filtr" role="group" aria-label="Filtruj realizacje">
					<label for="f-all">Wszystko <b>{projekty.length}</b></label>
					{
						kategorie.map((k) => (
							<label for={`f-${k.typ}`}>
								{etykietyTypow[k.typ]} <b>{k.ile}</b>
							</label>
						))
					}
				</div>
			</div>
		</section>

		<section class="indeks section--light">
			<div class="indeks__outer">
				<ol class="indeks__siatka">
					{
						projekty.map((p) => (
							<li class="kafel" data-typ={p.typ}>
								<a class="kafel__link" href={`/portfolio/${p.slug}`}>
									<div class="kafel__plyta">
										<PlytaRealizacji
											slug={p.slug}
											klient={p.klient}
											logo={p.logo}
											ratio="16 / 10"
											sizes="(max-width: 767px) 100vw, (max-width: 991px) 50vw, 33vw"
											widths={[360, 560, 760]}
										/>
									</div>

									<div class="kafel__body">
										<p class="kafel__meta">
											<span class="kafel__nr" />
											<i aria-hidden="true">·</i>
											<span>{etykietyTypow[p.typ]}</span>
										</p>
										<h3 class="kafel__klient">{p.klient}</h3>
										<p class="kafel__branza">{p.branza} · {p.rok}</p>
										<p class="kafel__zakres">{p.zakres}</p>
										<p class="kafel__efekt">{p.efekt}</p>
										<span class="kafel__cta">
											Zobacz projekt <i aria-hidden="true">→</i>
										</span>
									</div>
								</a>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<Oferta />
		<JakWygladaWspolpraca />
		<Cta />
	</main>
	<Footer />
</Layout>

<style>
	/* ===== Hero — masthead indeksu ===== */
	.pf-hero__outer {
		position: relative;
		max-width: var(--size-container);
		margin-inline: auto;
		padding-inline: var(--container-padding);
		padding-block: var(--spacing-3xl) var(--spacing-xl);
	}

	/* Blueprint brackets — ten sam motyw co w Cta */
	.pf-hero__corner {
		position: absolute;
		width: 1.25em;
		height: 1.25em;
		border-color: var(--accent-brand);
		border-style: solid;
		border-width: 0;
		pointer-events: none;
	}
	.pf-hero__corner--tl { top: 1em; left: 1.5em; border-left-width: 1px; border-top-width: 1px; }
	.pf-hero__corner--tr { top: 1em; right: 1.5em; border-right-width: 1px; border-top-width: 1px; }
	.pf-hero__corner--bl { bottom: 1em; left: 1.5em; border-left-width: 1px; border-bottom-width: 1px; }
	.pf-hero__corner--br { bottom: 1em; right: 1.5em; border-right-width: 1px; border-bottom-width: 1px; }

	.pf-hero__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.65em;
		font-size: 0.75em;
		font-weight: var(--weight-emphasis);
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}
	.pf-hero__eyebrow i { width: 0.55em; height: 0.55em; border-radius: 50%; background-color: var(--accent-brand); }
	.pf-hero__eyebrow b { color: var(--color-contrast); }
	.pf-hero__eyebrow > span { color: var(--accent-brand); }

	.pf-hero__split {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto;
		align-items: end;
		gap: var(--spacing-4xl);
		margin-top: var(--spacing-lg);
	}

	.pf-hero__title {
		font-family: var(--font-heading);
		font-size: var(--text-h1);
		font-weight: var(--weight-heading);
		line-height: var(--lh-display);
		letter-spacing: -1.5px;
		color: var(--color-contrast);
		text-wrap: balance;
	}
	.pf-hero__title span { display: block; color: var(--accent-text); }
	.pf-hero__lead {
		margin-top: var(--spacing-lg);
		max-width: 32em;
		font-size: var(--text-lead);
		line-height: var(--lh-lead);
		color: var(--color-text-secondary);
	}

	/* Szyna meta — wypełnia martwą prawą połowę treścią, która coś znaczy */
	.pf-hero__rail {
		display: grid;
		gap: 0.6em;
		min-width: 11em;
		padding-left: var(--spacing-xl);
		border-left: 1px solid var(--color-border);
	}
	.pf-hero__rail > div { display: flex; align-items: baseline; justify-content: space-between; gap: var(--spacing-md); }
	.pf-hero__rail dt { font-size: 0.8125em; color: var(--color-text-muted); }
	.pf-hero__rail dd {
		font-family: var(--font-heading);
		font-size: 0.9375em;
		font-weight: var(--weight-heading);
		font-variant-numeric: tabular-nums;
		color: var(--color-contrast);
	}

	/* ===== Indeks ===== */
	.indeks__outer {
		max-width: var(--size-container);
		margin-inline: auto;
		padding-inline: var(--container-padding);
		padding-block: var(--spacing-2xl) var(--spacing-section);
	}

	/* --- Filtr w foldzie: radio + `:has()`, zero JS.
	       `:has()` zamiast `~`, bo radia i siatka są w różnych sekcjach. --- */
	.pf-hero__filtr {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-top: var(--spacing-xl);
		padding-top: var(--spacing-xl);
		border-top: 1px solid var(--color-border);
	}
	.pf-hero__filtr label {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		min-height: 2.75em;
		padding: 0.6em 1.1em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background-color: var(--color-canvas);
		font-size: var(--text-sm);
		font-weight: var(--weight-emphasis);
		color: var(--color-text-secondary);
		cursor: pointer;
		transition:
			background-color var(--transition-base),
			border-color var(--transition-base),
			color var(--transition-base);
	}
	.pf-hero__filtr label b { font-weight: var(--weight-body); color: var(--color-text-muted); }
	.pf-hero__filtr label:hover { border-color: var(--accent-brand); color: var(--color-contrast); }

	.pf-hero__outer:has(#f-all:checked) label[for="f-all"],
	.pf-hero__outer:has(#f-strona:checked) label[for="f-strona"],
	.pf-hero__outer:has(#f-seo:checked) label[for="f-seo"],
	.pf-hero__outer:has(#f-system:checked) label[for="f-system"] {
		background-color: var(--accent-fill);
		border-color: var(--accent-fill);
		color: var(--color-contrast);
	}
	.pf-hero__outer:has(#f-all:checked) label[for="f-all"] b,
	.pf-hero__outer:has(#f-strona:checked) label[for="f-strona"] b,
	.pf-hero__outer:has(#f-seo:checked) label[for="f-seo"] b,
	.pf-hero__outer:has(#f-system:checked) label[for="f-system"] b {
		color: var(--color-contrast);
		opacity: 0.55;
	}

	.pf-hero__outer:has(#f-all:focus-visible) label[for="f-all"],
	.pf-hero__outer:has(#f-strona:focus-visible) label[for="f-strona"],
	.pf-hero__outer:has(#f-seo:focus-visible) label[for="f-seo"],
	.pf-hero__outer:has(#f-system:focus-visible) label[for="f-system"] {
		outline: 2px solid var(--accent-deep);
		outline-offset: 2px;
	}

	/* Filtr steruje siatką z innej sekcji — stąd `:has()` na wspólnym przodku */
	main:has(#f-strona:checked) .kafel:not([data-typ="strona"]),
	main:has(#f-seo:checked) .kafel:not([data-typ="seo"]),
	main:has(#f-system:checked) .kafel:not([data-typ="system"]) {
		display: none;
	}

	/* --- Siatka kafli. auto-fit zamiast breakpointów: liczba kolumn wynika z dostępnej
	       szerokości, nie z listy media queries. --- */
	.indeks__siatka {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(17em, 1fr));
		gap: var(--spacing-lg);
		counter-reset: rz;
		list-style: none;
	}

	/* Numeracja przez CSS counters — elementy z display:none nie inkrementują,
	   więc po filtrowaniu numeracja przelicza się sama na 01, 02, 03. */
	.kafel { counter-increment: rz; }

	.kafel__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		overflow: hidden;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		background-color: var(--color-canvas);
		box-shadow: var(--elevation-1);
		text-decoration: none;
		color: inherit;
		transition:
			box-shadow var(--transition-base),
			transform var(--transition-base),
			border-color var(--transition-base);
	}
	.kafel__link:hover {
		border-color: var(--accent-brand);
		box-shadow: var(--elevation-2);
		transform: translateY(-0.25em);
	}

	/* Płyta gubi własną ramkę i radius — kafel je już ma */
	.kafel__plyta :global(.plyta) {
		border: 0;
		border-bottom: 1px solid var(--color-border);
		border-radius: 0;
	}
	.kafel__link:hover .kafel__plyta :global(.plyta__img) { transform: scale(1.04); }

	.kafel__body {
		display: flex;
		flex-direction: column;
		flex-grow: 1;
		padding: var(--spacing-lg);
	}

	.kafel__meta {
		display: flex;
		align-items: center;
		gap: 0.45em;
		font-size: 0.6875em;
		font-weight: var(--weight-emphasis);
		letter-spacing: 1px;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}
	.kafel__nr {
		font-family: var(--font-heading);
		font-variant-numeric: tabular-nums;
		color: var(--accent-deep);
	}
	.kafel__nr::before { content: counter(rz, decimal-leading-zero); }
	.kafel__meta i { color: var(--accent-brand); font-style: normal; }

	.kafel__klient {
		margin-top: 0.5em;
		font-family: var(--font-heading);
		font-size: var(--text-h3);
		font-weight: var(--weight-heading);
		line-height: 1.15;
		letter-spacing: -0.5px;
		color: var(--color-contrast);
	}
	.kafel__branza {
		margin-top: 0.3em;
		font-size: 0.8125em;
		color: var(--color-text-muted);
	}
	.kafel__zakres {
		margin-top: var(--spacing-md);
		font-size: var(--text-sm);
		line-height: 1.5;
		color: var(--color-text-secondary);
	}

	/* Efekt jako badge — to on sprzedaje, więc dostaje kolor i wagę */
	.kafel__efekt {
		display: inline-block;
		align-self: flex-start;
		margin-top: var(--spacing-md);
		padding: 0.4em 0.7em;
		border-radius: var(--radius-sm);
		background-color: var(--accent-wash);
		font-size: 0.75em;
		font-weight: var(--weight-emphasis);
		line-height: 1.4;
		color: var(--accent-deep);
	}

	.kafel__cta {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		margin-top: auto;
		padding-top: var(--spacing-lg);
		font-size: var(--text-sm);
		font-weight: var(--weight-emphasis);
		color: var(--accent-deep);
	}
	.kafel__cta i { font-style: normal; transition: transform var(--transition-base); }
	.kafel__link:hover .kafel__cta i { transform: translateX(0.25em); }

	/* ===== Responsywność ===== */
	@media screen and (max-width: 991px) {
		.pf-hero__split { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-xl); align-items: start; }
		/* Szyna traci pionową kreskę i kładzie się w rząd pod nagłówkiem */
		.pf-hero__rail {
			grid-auto-flow: column;
			grid-auto-columns: max-content;
			justify-content: start;
			gap: var(--spacing-xl);
			min-width: 0;
			padding-left: 0;
			padding-top: var(--spacing-lg);
			border-left: 0;
			border-top: 1px solid var(--color-border);
		}
		.pf-hero__rail > div { flex-direction: column; gap: 0.2em; justify-content: flex-start; }
	}

	@media screen and (max-width: 767px) {
		.pf-hero__outer { padding-block: var(--spacing-2xl) var(--spacing-lg); }
		.pf-hero__title { letter-spacing: -0.5px; }
		.pf-hero__corner { display: none; }
		.pf-hero__rail { gap: var(--spacing-lg); }
		.indeks__outer { padding-block: var(--spacing-lg) var(--spacing-4xl); }
		.indeks__siatka { grid-template-columns: minmax(0, 1fr); gap: var(--spacing-md); }
		.kafel__body { padding: var(--spacing-md); }
	}
</style>
