---
// Portfolio — indeks realizacji. Ledger, nie siatka kart: rzędy na widocznej siatce
// 12-kolumnowej, rozdzielone hairline'ami. Czyta się jak spis prac wykonawcy.
//
// Poszarpana prawa krawędź jest sterowana danymi (proporcje płyty wg `typ`), zero kodu
// per projekt. Filtr: radio + kombinator `~`, bez grama JS.

import Layout from "../layouts/Layout.astro";
import Oferta from "../components/Oferta.astro";
import JakWygladaWspolpraca from "../components/JakWygladaWspolpraca.astro";
import Cta from "../components/Cta.astro";
import Footer from "../components/Footer.astro";
import PlytaRealizacji from "../components/PlytaRealizacji.astro";
import { projekty, etykietyTypow, proporcjeTypu, type Typ } from "../data/projekty";

// Renderujemy tylko kategorie, które mają min. 1 realizację — pusty stan nigdy nie
// powstaje, więc nie trzeba go projektować.
const kolejnoscTypow: Typ[] = ["strona", "seo", "system"];
const kategorie = kolejnoscTypow
	.map((typ) => ({ typ, ile: projekty.filter((p) => p.typ === typ).length }))
	.filter((k) => k.ile > 0);

const najstarszy = Math.min(...projekty.map((p) => p.rok));
---

<Layout
	title="Portfolio — realizacje | FilarAI"
	description="Strony WWW, systemy AI i SEO dla firm usługowych i produkcyjnych. Konkretne wdrożenia, konkretne efekty."
>
	<main id="main">
		<section class="pf-hero section--atmosphere">
			<div class="pf-hero__outer">
				<h1 class="pf-hero__title">Konkretne firmy.<span>Konkretne wdrożenia.</span></h1>
				<p class="pf-hero__lead">
					Bez okrągłych zdań o „transformacji". Poniżej to, co zbudowałem, dla kogo
					i co się przez to zmieniło.
				</p>
				<p class="pf-hero__licznik">{projekty.length} realizacji, od {najstarszy}</p>
			</div>
		</section>

		<section class="indeks section--light">
			<div class="indeks__outer">
				{/* Radia PRZED listą — wymóg kombinatora `~`. */}
				<input type="radio" name="filtr" id="f-all" class="sr-only" checked />
				{kategorie.map((k) => <input type="radio" name="filtr" id={`f-${k.typ}`} class="sr-only" />)}

				<div class="indeks__filtr" role="group" aria-label="Filtruj realizacje">
					<label for="f-all">Wszystko <b>{projekty.length}</b></label>
					{
						kategorie.map((k) => (
							<label for={`f-${k.typ}`}>
								{etykietyTypow[k.typ]} <b>{k.ile}</b>
							</label>
						))
					}
				</div>

				<ol class="indeks__lista">
					{
						projekty.map((p) => (
							<li class="indeks__rz" data-typ={p.typ}>
								<a class="indeks__link" href={`/portfolio/${p.slug}`}>
									<span class="indeks__nr" aria-hidden="true" />
									<div class="indeks__szyna">
										<h3 class="indeks__klient">{p.klient}</h3>
										<p class="indeks__meta">
											<span>{p.branza}</span>
											<i aria-hidden="true">·</i>
											<span>{etykietyTypow[p.typ]}</span>
											<i aria-hidden="true">·</i>
											<span>{p.rok}</span>
										</p>
										<p class="indeks__zakres">{p.zakres}</p>
										<p class="indeks__efekt">{p.efekt}</p>
									</div>
									<div class="indeks__plyta">
										<PlytaRealizacji
											slug={p.slug}
											klient={p.klient}
											logo={p.logo}
											ratio={proporcjeTypu[p.typ]}
											sizes="(max-width: 991px) 100vw, 55vw"
										/>
									</div>
								</a>
							</li>
						))
					}
				</ol>
			</div>
		</section>

		<Oferta />
		<JakWygladaWspolpraca />
		<Cta />
	</main>
	<Footer />
</Layout>

<style>
	/* ===== Hero ===== */
	.pf-hero__outer {
		max-width: var(--size-container);
		margin-inline: auto;
		padding-inline: var(--container-padding);
		padding-block: var(--spacing-section) var(--spacing-4xl);
	}
	.pf-hero__title {
		font-family: var(--font-heading);
		font-size: var(--text-h1);
		font-weight: var(--weight-heading);
		line-height: var(--lh-display);
		letter-spacing: -1.5px;
		color: var(--color-contrast);
		text-wrap: balance;
	}
	.pf-hero__title span { display: block; color: var(--accent-text); }
	.pf-hero__lead {
		margin-top: var(--spacing-lg);
		max-width: 34em;
		font-size: var(--text-lead);
		line-height: var(--lh-lead);
		color: var(--color-text-secondary);
	}
	.pf-hero__licznik {
		margin-top: var(--spacing-xl);
		font-size: var(--text-sm);
		font-weight: var(--weight-emphasis);
		letter-spacing: 1px;
		color: var(--color-text-muted);
	}

	/* ===== Indeks ===== */
	.indeks__outer {
		max-width: var(--size-container);
		margin-inline: auto;
		padding-inline: var(--container-padding);
		padding-block: var(--spacing-2xl) var(--spacing-section);
	}

	/* --- Filtr: radio + `~`, zero JS --- */
	.indeks__filtr {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
		margin-bottom: var(--spacing-2xl);
	}
	.indeks__filtr label {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		min-height: 2.75em;
		padding: 0.6em 1.1em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		background-color: var(--color-canvas);
		font-size: var(--text-sm);
		font-weight: var(--weight-emphasis);
		color: var(--color-text-secondary);
		cursor: pointer;
		transition:
			background-color var(--transition-base),
			border-color var(--transition-base),
			color var(--transition-base);
	}
	.indeks__filtr label b { font-weight: var(--weight-body); color: var(--color-text-muted); }
	.indeks__filtr label:hover { border-color: var(--accent-brand); color: var(--color-contrast); }

	#f-all:checked ~ .indeks__filtr label[for="f-all"],
	#f-strona:checked ~ .indeks__filtr label[for="f-strona"],
	#f-seo:checked ~ .indeks__filtr label[for="f-seo"],
	#f-system:checked ~ .indeks__filtr label[for="f-system"] {
		background-color: var(--accent-fill);
		border-color: var(--accent-fill);
		color: var(--color-contrast);
	}
	#f-all:checked ~ .indeks__filtr label[for="f-all"] b,
	#f-strona:checked ~ .indeks__filtr label[for="f-strona"] b,
	#f-seo:checked ~ .indeks__filtr label[for="f-seo"] b,
	#f-system:checked ~ .indeks__filtr label[for="f-system"] b {
		color: var(--color-contrast);
		opacity: 0.55;
	}

	#f-all:focus-visible ~ .indeks__filtr label[for="f-all"],
	#f-strona:focus-visible ~ .indeks__filtr label[for="f-strona"],
	#f-seo:focus-visible ~ .indeks__filtr label[for="f-seo"],
	#f-system:focus-visible ~ .indeks__filtr label[for="f-system"] {
		outline: 2px solid var(--accent-deep);
		outline-offset: 2px;
	}

	#f-strona:checked ~ .indeks__lista .indeks__rz:not([data-typ="strona"]),
	#f-seo:checked ~ .indeks__lista .indeks__rz:not([data-typ="seo"]),
	#f-system:checked ~ .indeks__lista .indeks__rz:not([data-typ="system"]) {
		display: none;
	}

	/* --- Lista: numeracja przez CSS counters. Elementy z display:none nie inkrementują,
	       więc po filtrowaniu numeracja przelicza się sama na 01, 02, 03. --- */
	.indeks__lista {
		counter-reset: rz;
		list-style: none;
		border-top: 1px solid var(--color-border);
	}
	.indeks__rz {
		counter-increment: rz;
		border-bottom: 1px solid var(--color-border);
		transition: border-color var(--transition-base);
	}
	.indeks__rz:hover { border-bottom-color: var(--accent-brand); }

	.indeks__link {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		column-gap: var(--spacing-lg);
		align-items: center;
		padding-block: var(--spacing-2xl);
		text-decoration: none;
		color: inherit;
	}

	.indeks__nr {
		grid-column: 1 / 2;
		align-self: start;
		font-family: var(--font-heading);
		font-size: var(--text-sm);
		font-weight: var(--weight-heading);
		font-variant-numeric: tabular-nums;
		color: var(--color-text-muted);
		transition: color var(--transition-base);
	}
	.indeks__nr::before { content: counter(rz, decimal-leading-zero); }
	.indeks__rz:hover .indeks__nr { color: var(--accent-deep); }

	.indeks__szyna { grid-column: 2 / 5; }
	.indeks__klient {
		font-family: var(--font-heading);
		font-size: var(--text-h3);
		font-weight: var(--weight-heading);
		line-height: 1.15;
		letter-spacing: -0.5px;
		color: var(--color-contrast);
	}
	.indeks__meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45em;
		margin-top: 0.4em;
		font-size: 0.8125em;
		color: var(--color-text-muted);
	}
	.indeks__meta i { color: var(--accent-brand); font-style: normal; }
	.indeks__zakres {
		margin-top: var(--spacing-md);
		font-size: var(--text-sm);
		line-height: 1.55;
		color: var(--color-text-secondary);
	}
	.indeks__efekt {
		margin-top: var(--spacing-md);
		font-size: var(--text-sm);
		font-weight: var(--weight-emphasis);
		line-height: 1.5;
		color: var(--accent-deep);
	}

	/* Poszarpana prawa krawędź — sterowana `typ`, zero kodu per projekt */
	.indeks__plyta { overflow: hidden; border-radius: var(--radius-md); }
	.indeks__rz[data-typ="strona"] .indeks__plyta { grid-column: 5 / 13; }
	.indeks__rz[data-typ="seo"] .indeks__plyta { grid-column: 6 / 13; }
	.indeks__rz[data-typ="system"] .indeks__plyta { grid-column: 7 / 13; }

	.indeks__rz:hover .indeks__plyta :global(.plyta__img) { transform: scale(1.03); }

	/* ===== Responsywność ===== */
	@media screen and (max-width: 991px) {
		/* Poszarpana krawędź nie ma sensu przy jednej kolumnie */
		.indeks__link { grid-template-columns: 2.5em minmax(0, 1fr); row-gap: var(--spacing-lg); }
		.indeks__nr { grid-column: 1 / 2; grid-row: 1; }
		.indeks__szyna { grid-column: 2 / 3; grid-row: 1; }
		.indeks__rz[data-typ="strona"] .indeks__plyta,
		.indeks__rz[data-typ="seo"] .indeks__plyta,
		.indeks__rz[data-typ="system"] .indeks__plyta {
			grid-column: 1 / 3;
			grid-row: 2;
			--plyta-ratio: 16 / 10;
		}
	}

	@media screen and (max-width: 767px) {
		.pf-hero__outer { padding-block: var(--spacing-4xl) var(--spacing-2xl); }
		.pf-hero__title { letter-spacing: -0.5px; }
		.indeks__outer { padding-block: var(--spacing-lg) var(--spacing-4xl); }
		.indeks__link { grid-template-columns: minmax(0, 1fr); padding-block: var(--spacing-xl); }
		/* Numer wchodzi inline przed nazwę klienta */
		.indeks__nr { display: none; }
		.indeks__szyna { grid-column: 1 / -1; grid-row: 1; }
		.indeks__klient::before {
			content: counter(rz, decimal-leading-zero) " ";
			margin-right: 0.4em;
			font-size: 0.7em;
			font-variant-numeric: tabular-nums;
			color: var(--color-text-muted);
		}
		.indeks__rz[data-typ="strona"] .indeks__plyta,
		.indeks__rz[data-typ="seo"] .indeks__plyta,
		.indeks__rz[data-typ="system"] .indeks__plyta {
			grid-column: 1 / -1;
		}
	}
</style>
