---
// Cta — redesign wg attachment. Dark bg z lime akcentem, corner brackets [ ] jak blueprint,
// duży H2 wycentrowany, 2 CTA, 3 features, divider, "Zaufali mi:" + logotypy klientów.

const features = [
	{
		text: "Odpowiadam w 15 minut",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>`,
	},
	{
		text: "Bez zobowiązań",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.5 8.5-8 9-4.5-.5-8-4.5-8-9V6l8-3z"/></svg>`,
	},
	{
		text: "Rozmawiasz bezpośrednio ze mną",
		icon: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/></svg>`,
	},
];

// Ten sam zestaw i warianty plików co w LogoStrip bezpośrednio pod Hero.
// Wszystkie zostały przygotowane na ciemne tło, dlatego zachowują czytelność w CTA.
const clients = [
	{ label: "Planeta Mebli", src: "/klienci/loga/planeta-mebli-light.svg", ratio: "1921 / 819" },
	{ label: "Domki na Luzie", src: "/klienci/loga/domki-na-luzie.svg", ratio: "1888.74 / 471.98" },
	{ label: "Filar Drone", src: "/klienci/loga/filar-drone-light.svg", ratio: "1916 / 821" },
	{ label: "Eden Capital", src: "/klienci/loga/eden-capital-light.svg", ratio: "1540 / 387" },
	{ label: "Parafia św. Marii Magdaleny", src: "/klienci/loga/parafia-jasne.svg", ratio: "1254 / 1254", scale: 1.6 },
	{ label: "HC", src: "/klienci/loga/hc.svg", ratio: "1700 / 1700", scale: 1.4 },
];
---

<section class="cta section--atmosphere">
	<div class="cta__outer">
		<div class="cta__frame">
			<span class="cta__corner cta__corner--tl" aria-hidden="true"></span>
			<span class="cta__corner cta__corner--tr" aria-hidden="true"></span>
			<span class="cta__corner cta__corner--bl" aria-hidden="true"></span>
			<span class="cta__corner cta__corner--br" aria-hidden="true"></span>

			<div class="cta__eyebrow" aria-hidden="true">
				<span class="cta__bracket">[</span>
				<span class="cta__eyebrow-dot"></span>
				<span class="cta__eyebrow-text">Gotowi na start?</span>
				<span class="cta__bracket">]</span>
			</div>

			<h2 class="cta__title">Porozmawiajmy o Twojej firmie</h2>
			<p class="cta__subtitle">
				Pierwsza rozmowa nic nie kosztuje – zobaczymy, czy mogę Ci pomóc.
			</p>

			<div class="cta__status">
				<span class="cta__status-dot" aria-hidden="true"></span>
				Dostępny teraz
			</div>

			<div class="cta__buttons">
				<a href="/kontakt" class="cta__btn cta__btn--primary">
					<span>Umów rozmowę</span>
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18">
						<path d="M5 12h14M13 6l6 6-6 6" />
					</svg>
				</a>
				<a href="https://wa.me/+48534458418" class="cta__btn cta__btn--ghost" target="_blank" rel="noopener">
					<span>Napisz na WhatsApp</span>
					<span class="cta__btn-icon" aria-hidden="true">
						<svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
							<path d="M12.04 2c-5.46 0-9.9 4.44-9.9 9.9 0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.9 9.9 0 0 0 4.79 1.21c5.46 0 9.9-4.44 9.9-9.9 0-5.46-4.44-9.9-9.9-9.9zM17 15.62c-.2.55-1.16 1.06-1.6 1.13-.42.07-.94.1-1.53-.1-.36-.11-.83-.27-1.44-.53-2.53-1.09-4.18-3.63-4.31-3.8-.13-.16-1.03-1.36-1.03-2.6 0-1.23.64-1.83.87-2.09.23-.26.5-.32.66-.32h.48c.15 0 .35-.06.55.42.2.5.7 1.71.76 1.83.06.13.1.28.02.44-.08.16-.12.26-.23.4-.11.14-.23.31-.33.42-.11.11-.22.24-.1.47.13.23.58.96 1.24 1.56.85.75 1.57 1 1.8 1.11.23.11.36.09.5-.05.13-.14.57-.66.72-.89.15-.23.3-.19.51-.12.21.08 1.34.63 1.57.74.23.11.38.17.44.26.06.09.06.55-.14 1.08z" />
						</svg>
					</span>
				</a>
			</div>

			<div class="cta__features">
				{
					features.map((f, i) => (
						<>
							{i > 0 && <span class="cta__feat-sep" aria-hidden="true"></span>}
							<div class="cta__feature">
								<span class="cta__feat-icon" set:html={f.icon} />
								<span>{f.text}</span>
							</div>
						</>
					))
				}
			</div>

			<div class="cta__divider" aria-hidden="true"></div>

			<p class="cta__trust-label">Zaufali mi:</p>

			<div class="cta__trust-blueprint" aria-hidden="true">
				<span class="cta__blueprint-plus">+</span>
				<span class="cta__blueprint-bracket cta__blueprint-bracket--l"></span>
				<span class="cta__blueprint-line"></span>
				<span class="cta__blueprint-bracket cta__blueprint-bracket--r"></span>
				<span class="cta__blueprint-plus">+</span>
			</div>

			<ul class="cta__logos">
				{
					clients.map((c) => (
						<li class="cta__logo">
							<img
								class="cta__logo-image"
								src={c.src}
								alt={c.label}
								style={`--logo-ratio: ${c.ratio}; --logo-scale: ${c.scale ?? 1};`}
							/>
						</li>
					))
				}
			</ul>
		</div>
	</div>
</section>

<style>
	.cta__outer {
		max-width: var(--size-container);
		margin-inline: auto;
		padding-inline: 1.5em;
		padding-block: var(--spacing-section);
	}

	.cta__frame {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: 4em 3em 3em;
		background-color: var(--color-atmosphere-dark);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 1.75em;
		color: var(--color-text-on-dark);
	}

	/* ===== Corner brackets [ ] ===== */

	.cta__corner {
		position: absolute;
		width: 1.75em;
		height: 1.75em;
		border-color: rgba(214, 253, 112, 0.55);
		border-style: solid;
		border-width: 0;
	}

	.cta__corner--tl {
		top: 1.25em;
		left: 1.25em;
		border-top-width: 1px;
		border-left-width: 1px;
	}
	.cta__corner--tr {
		top: 1.25em;
		right: 1.25em;
		border-top-width: 1px;
		border-right-width: 1px;
	}
	.cta__corner--bl {
		bottom: 1.25em;
		left: 1.25em;
		border-bottom-width: 1px;
		border-left-width: 1px;
	}
	.cta__corner--br {
		bottom: 1.25em;
		right: 1.25em;
		border-bottom-width: 1px;
		border-right-width: 1px;
	}

	/* ===== Eyebrow ===== */

	.cta__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.75em;
		font-family: var(--font-body);
		font-size: 0.8125em;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--color-text-on-dark);
		margin-bottom: 1.25em;
	}

	.cta__bracket {
		color: rgba(214, 253, 112, 0.6);
		font-weight: 400;
	}

	.cta__eyebrow-dot {
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background-color: var(--color-accent);
	}

	/* ===== Title + subtitle ===== */

	.cta__title {
		font-family: var(--font-heading);
		font-size: var(--text-cta);
		font-weight: 700;
		line-height: 1.05;
		/* -2px było dobrane pod 96px. Przy 56px to -0.036em — litery się sklejają.
		   -1px ≈ -0.018em, mieści się w normie dla display (-0.01 do -0.02em). */
		letter-spacing: -1px;
		color: var(--color-text-on-dark);
	}

	.cta__subtitle {
		margin-top: 1em;
		max-width: 32em;
		font-size: var(--text-lead);
		line-height: var(--lh-lead);
		color: var(--color-text-on-dark-muted);
	}

	.cta__status {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		margin-top: 1.75em;
		font-family: var(--font-body);
		font-size: 1em;
		color: var(--color-text-on-dark);
	}

	.cta__status-dot {
		width: 0.625em;
		height: 0.625em;
		border-radius: 50%;
		background-color: var(--color-accent);
		box-shadow: 0 0 12px var(--color-accent);
	}

	/* ===== Buttons ===== */

	.cta__buttons {
		display: flex;
		gap: 1em;
		margin-top: 1.75em;
	}

	.cta__btn {
		display: inline-flex;
		align-items: center;
		gap: 0.625em;
		padding: 1em 1.75em;
		font-family: var(--font-body);
		font-size: 1em;
		font-weight: 600;
		border-radius: 999em;
		text-decoration: none;
		transition: transform 180ms ease;
	}

	.cta__btn:hover {
		transform: translateY(-1px);
	}

	.cta__btn--primary {
		background-color: var(--color-accent);
		color: var(--color-contrast);
	}

	.cta__btn--ghost {
		background-color: transparent;
		color: var(--color-text-on-dark);
		border: 1px solid rgba(255, 255, 255, 0.25);
	}

	.cta__btn-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.5em;
		height: 1.5em;
		border-radius: 50%;
		background-color: #25d366;
		color: var(--color-canvas);
	}

	/* ===== Features row ===== */

	.cta__features {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		justify-content: center;
		gap: 1.5em;
		margin-top: 2.5em;
	}

	.cta__feature {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		font-size: 0.9375em;
		color: var(--color-text-on-dark-muted);
	}

	.cta__feat-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.125em;
		height: 1.125em;
		color: var(--color-text-on-dark);
	}

	.cta__feat-icon svg {
		width: 100%;
		height: 100%;
	}

	.cta__feat-sep {
		width: 1px;
		height: 1em;
		background-color: rgba(255, 255, 255, 0.15);
	}

	/* ===== Divider ===== */

	.cta__divider {
		width: 100%;
		height: 1px;
		margin-top: 2.75em;
		background-color: rgba(255, 255, 255, 0.08);
	}

	/* ===== Trust label ===== */

	.cta__trust-label {
		margin-top: 1.75em;
		font-family: var(--font-body);
		font-size: 0.75em;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--color-text-on-dark-muted);
	}

	/* ===== Blueprint decor pod "Zaufali mi:" ===== */

	.cta__trust-blueprint {
		display: flex;
		align-items: center;
		width: 100%;
		gap: 0.5em;
		margin-top: 1em;
		color: rgba(214, 253, 112, 0.55);
	}

	.cta__blueprint-plus {
		font-family: var(--font-heading);
		font-weight: 400;
		line-height: 1;
	}

	.cta__blueprint-bracket {
		width: 0.75em;
		height: 0.75em;
		border-color: currentColor;
		border-style: solid;
		border-width: 0;
	}

	.cta__blueprint-bracket--l {
		border-left-width: 1px;
		border-top-width: 1px;
		border-bottom-width: 1px;
	}

	.cta__blueprint-bracket--r {
		border-right-width: 1px;
		border-top-width: 1px;
		border-bottom-width: 1px;
	}

	.cta__blueprint-line {
		flex: 1;
		height: 1px;
		background-image: linear-gradient(to right, currentColor 0, currentColor 4px, transparent 4px, transparent 8px);
		background-size: 8px 1px;
		background-repeat: repeat-x;
	}

	/* ===== Logos row ===== */

	.cta__logos {
		display: grid;
		grid-template-columns: repeat(6, minmax(0, 1fr));
		gap: 1.5em;
		width: 100%;
		margin-top: 1.5em;
		list-style: none;
	}

	.cta__logo {
		display: flex;
		align-items: center;
		justify-content: center;
		min-height: 3.5em;
		text-align: center;
		opacity: 0.85;
		transition: opacity 220ms ease, transform 220ms ease;
	}

	.cta__logo-image {
		display: block;
		width: auto;
		height: calc(2.15em * var(--logo-scale, 1));
		max-width: 100%;
		aspect-ratio: var(--logo-ratio);
		object-fit: contain;
	}

	.cta__logo:hover {
		opacity: 1;
		transform: scale(1.04);
	}

	/* ===== Responsywność ===== */

	@media screen and (max-width: 991px) {
		.cta__frame {
			padding: 3em 2em 2em;
		}


		.cta__logos {
			grid-template-columns: repeat(3, minmax(0, 1fr));
			row-gap: 1.5em;
		}
	}

	@media screen and (max-width: 767px) {

		.cta__buttons {
			flex-direction: column;
			width: 100%;
		}

		.cta__btn {
			justify-content: center;
			width: 100%;
		}

		.cta__logos {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.cta__features {
			flex-direction: column;
			gap: 0.75em;
		}

		.cta__feat-sep {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cta__logo {
			transition: opacity 180ms ease;
		}
	}
</style>
