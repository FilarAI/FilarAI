---
// Baner zgody na cookies.
//
// Dwie rzeczy są tu wymogiem prawnym, nie decyzją projektową — nie zmieniaj ich
// bez świadomości konsekwencji:
//
// 1. ODMOWA MUSI BYĆ RÓWNIE ŁATWA CO ZGODA. Oba przyciski są tej samej wielkości,
//    w tym samym rzędzie, jeden klik. Baner z wielkim "Akceptuj" i schowanym
//    "Odrzuć" daje zgodę NIEWAŻNĄ w świetle RODO (art. 7 ust. 3 + wytyczne EROD).
// 2. Brak zgody = brak śledzenia. Do czasu kliknięcia NIC się nie ładuje.
//    Zgoda musi być czynnością aktywną — samo przewijanie strony jej nie zastępuje.
//
// Klucz localStorage i czas życia (12 mies.) muszą się zgadzać z tabelą
// w src/pages/polityka-prywatnosci.astro. Zmieniasz jedno — zmień drugie.
---

<div
	class="cookie"
	id="cookie-banner"
	role="dialog"
	aria-modal="false"
	aria-labelledby="cookie-title"
	aria-describedby="cookie-desc"
	hidden
>
	<div class="cookie__card">
		<div class="cookie__body">
			<h2 class="cookie__title" id="cookie-title">Cookies — krótko i bez ściemy</h2>
			<p class="cookie__desc" id="cookie-desc">
				Ta strona nie ma Google Analytics ani piksela Facebooka. Zapisuję tylko jedną rzecz: Twój
				wybór poniżej, żeby nie pytać przy każdej wizycie. Jeśli kiedyś dojdzie analityka, zapytam
				najpierw.
			</p>
			<a href="/polityka-prywatnosci" class="cookie__link">Przeczytaj politykę prywatności</a>
		</div>

		<div class="cookie__actions">
			<button type="button" class="cookie__btn cookie__btn--ghost" data-consent="essential">
				Tylko niezbędne
			</button>
			<button type="button" class="cookie__btn cookie__btn--primary" data-consent="all">
				Akceptuję wszystkie
			</button>
		</div>
	</div>
</div>

<script>
	const STORAGE_KEY = "filarai-cookie-consent";
	const MAX_AGE_MS = 365 * 24 * 60 * 60 * 1000; // 12 miesięcy — jak w polityce prywatności

	type Consent = {
		choice: "all" | "essential";
		ts: number;
	};

	const banner = document.getElementById("cookie-banner");
	if (banner) {
		const read = (): Consent | null => {
			try {
				const raw = localStorage.getItem(STORAGE_KEY);
				if (!raw) return null;
				const parsed = JSON.parse(raw) as Consent;
				// Zgoda wygasa — po roku pytamy ponownie.
				if (Date.now() - parsed.ts > MAX_AGE_MS) {
					localStorage.removeItem(STORAGE_KEY);
					return null;
				}
				return parsed;
			} catch {
				// Prywatne okno / zablokowany storage — traktujemy jak brak zgody.
				return null;
			}
		};

		const save = (choice: Consent["choice"]) => {
			try {
				localStorage.setItem(STORAGE_KEY, JSON.stringify({ choice, ts: Date.now() }));
			} catch {
				// Nie da się zapisać — trudno. Baner pokaże się znowu, ale nic się nie psuje.
			}
			// Hook dla przyszłej analityki: skrypty startują TYLKO na to zdarzenie,
			// nigdy przy ładowaniu strony.
			document.dispatchEvent(new CustomEvent("filarai:consent", { detail: { choice } }));
		};

		const hide = () => {
			banner.dataset.leaving = "true";
			const done = () => banner.setAttribute("hidden", "");
			const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			if (reduced) done();
			else banner.addEventListener("transitionend", done, { once: true });
		};

		const existing = read();
		if (existing) {
			// Zgoda już jest — nie pokazujemy banera, ale odpalamy zdarzenie,
			// żeby skrypty zależne od zgody wystartowały po odświeżeniu strony.
			document.dispatchEvent(
				new CustomEvent("filarai:consent", { detail: { choice: existing.choice } })
			);
		} else {
			banner.removeAttribute("hidden");
			// Wymuszenie reflow, żeby transition wejścia zadziałało.
			void banner.offsetHeight;
			banner.dataset.visible = "true";

			banner.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((btn) => {
				btn.addEventListener("click", () => {
					save(btn.dataset.consent as Consent["choice"]);
					hide();
				});
			});
		}
	}
</script>

<style>
	.cookie {
		position: fixed;
		bottom: 1.25em;
		left: 1.25em;
		z-index: 60; /* nad ScrollNav (40) i headerem (50) */
		width: min(26em, calc(100vw - 2.5em));
		opacity: 0;
		transform: translateY(0.75em);
		transition:
			opacity 300ms ease,
			transform 300ms ease;
	}

	.cookie[data-visible="true"] {
		opacity: 1;
		transform: translateY(0);
	}

	.cookie[data-leaving="true"] {
		opacity: 0;
		transform: translateY(0.75em);
		pointer-events: none;
	}

	.cookie__card {
		display: flex;
		flex-direction: column;
		gap: 1.25em;
		padding: 1.5em;
		background-color: var(--color-canvas);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-card-hover);
	}

	/* ===== Treść ===== */

	.cookie__body {
		display: flex;
		flex-direction: column;
		gap: 0.5em;
	}

	.cookie__title {
		font-size: 1.0625em;
		font-weight: 600;
		line-height: 1.3;
		color: var(--color-contrast);
	}

	.cookie__desc {
		font-size: 0.9375em;
		line-height: 1.55;
		color: var(--color-text-secondary);
	}

	.cookie__link {
		align-self: flex-start;
		font-size: 0.875em;
		font-weight: var(--weight-emphasis);
		color: var(--accent-deep);
		text-decoration: underline;
		text-underline-offset: 0.15em;
		text-decoration-thickness: 1px;
	}

	.cookie__link:hover {
		text-decoration-thickness: 2px;
	}

	/* ===== Przyciski =====
	   Oba mają identyczną wysokość i flex: 1 — żaden nie jest wizualnie
	   uprzywilejowany. To wymóg, nie estetyka (patrz komentarz na górze pliku). */

	.cookie__actions {
		display: flex;
		gap: 0.625em;
	}

	.cookie__btn {
		flex: 1;
		min-height: 2.75em; /* 44px — touch target */
		padding-inline: 1em;
		font-family: var(--font-body);
		font-size: 0.9375em;
		font-weight: var(--weight-emphasis);
		line-height: 1.2;
		border-radius: var(--radius-pill);
		cursor: pointer;
		transition:
			background-color var(--transition-base),
			border-color var(--transition-base),
			transform var(--transition-fast);
	}

	.cookie__btn:active {
		transform: scale(0.98);
	}

	.cookie__btn--ghost {
		background-color: var(--color-canvas);
		color: var(--color-contrast);
		border: 1px solid var(--color-border);
	}

	.cookie__btn--ghost:hover {
		background-color: var(--color-atmosphere);
		border-color: var(--color-text-muted);
	}

	.cookie__btn--primary {
		background-color: var(--accent-fill);
		color: var(--color-contrast);
		border: 1px solid var(--accent-fill);
	}

	.cookie__btn--primary:hover {
		background-color: var(--accent-brand);
		border-color: var(--accent-brand);
	}

	/* ===== Responsywność ===== */

	@media screen and (max-width: 767px) {
		.cookie {
			bottom: 0.75em;
			left: 0.75em;
			width: calc(100vw - 1.5em);
		}

		.cookie__card {
			padding: 1.25em;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cookie,
		.cookie__btn {
			transition: none;
		}

		.cookie__btn:active {
			transform: none;
		}
	}
</style>
