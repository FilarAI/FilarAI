---
// StronyZakres — "co dostajesz" jako datasheet, nie siatka ikon-kart. Ciemny blok
// kontrastu (celowy wyjątek wg PROJECT_BRIEF: sekcje ciemne odwracają hierarchię).
// Stack techniczny doklejony jako stopka tej samej sekcji — buduje zaufanie, nie
// wymaga osobnej sekcji.

const spec = [
	{
		id: "01",
		label: "Design pod Twoją markę",
		desc: "Projekt od zera, dopasowany do tego, co sprzedajesz. Zero szablonów z marketplace.",
	},
	{
		id: "02",
		label: "Mobile-first",
		desc: "Ponad połowa Twoich klientów wejdzie z telefonu. Zaczynam od nich, nie od desktopu.",
	},
	{
		id: "03",
		label: "SEO on-page",
		desc: "Struktura nagłówków, meta, dane strukturalne i sitemap. Google wie, co u Ciebie jest.",
	},
	{
		id: "04",
		label: "Szybkość",
		desc: "Statyczny build, obrazy pod kontrolą. Strona ładuje się zanim klient zdąży wyjść.",
	},
	{
		id: "05",
		label: "Samodzielna edycja",
		desc: "CMS w pakietach wielostronicowych. Zmieniasz treść bez dzwonienia do mnie.",
	},
	{
		id: "06",
		label: "Zapytania tam, gdzie zaglądasz",
		desc: "Formularz leci na maila lub prosto do CRM. Żaden lead nie ginie w panelu.",
	},
];

const stack = ["Astro", "TypeScript", "Vercel / Netlify", "Cloudflare"];
---

<section class="zakres section--dark">
	<div class="zakres__outer">
		<div class="zakres__head">
			<h2 class="zakres__title">W każdym projekcie, bez dopłat.</h2>
			<p class="zakres__lead">To nie jest lista opcji do wyboru. Tak buduję każdą stronę, niezależnie od pakietu.</p>
		</div>

		<dl class="zakres__spec">
			{
				spec.map((s) => (
					<div class="zakres__row">
						<dt class="zakres__label">
							<span class="zakres__id" aria-hidden="true">{s.id}</span>
							{s.label}
						</dt>
						<dd class="zakres__desc">{s.desc}</dd>
					</div>
				))
			}
		</dl>

		<div class="zakres__stack">
			<span class="zakres__stack-label">Zbudowane na</span>
			<ul class="zakres__stack-list">
				{stack.map((t) => <li>{t}</li>)}
			</ul>
			<p class="zakres__stack-note">Nie WordPress z dwudziestoma wtyczkami. Nowoczesny stack, który się nie sypie i nie wymaga comiesięcznych aktualizacji.</p>
		</div>
	</div>
</section>

<style>
	.zakres {
		background-color: var(--color-atmosphere-dark);
		color: var(--color-text-on-dark);
	}
	.zakres__outer {
		max-width: var(--size-container);
		margin-inline: auto;
		padding-inline: var(--container-padding);
		padding-block: var(--spacing-section);
	}

	.zakres__head { max-width: 34em; margin-bottom: var(--spacing-3xl); }
	.zakres__title {
		font-family: var(--font-heading);
		font-size: var(--text-h2);
		font-weight: var(--weight-heading);
		line-height: var(--lh-heading);
		letter-spacing: -1px;
		color: var(--color-text-on-dark);
		text-wrap: balance;
	}
	.zakres__lead { margin-top: var(--spacing-md); font-size: var(--text-lead); line-height: 1.65; color: var(--color-text-on-dark-muted); }

	/* Datasheet: sztywna siatka, hairline'y jako struktura — nie karty */
	.zakres__spec { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--spacing-4xl); }
	.zakres__row {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.5em;
		padding-block: var(--spacing-xl);
		border-top: 1px solid var(--color-border-on-dark);
	}
	.zakres__label {
		display: grid;
		grid-template-columns: 2.5em minmax(0, 1fr);
		align-items: baseline;
		gap: 0.5em;
		font-family: var(--font-heading);
		font-size: 1.25em;
		font-weight: var(--weight-heading);
		letter-spacing: -0.3px;
		color: var(--color-text-on-dark);
	}
	.zakres__id { font-size: 0.6em; font-weight: var(--weight-emphasis); letter-spacing: 0.1em; color: var(--accent-brand); }
	.zakres__desc { padding-left: 3em; font-size: var(--text-sm); line-height: 1.6; color: var(--color-text-on-dark-muted); }

	/* Stack — stopka sekcji */
	.zakres__stack {
		display: grid;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: center;
		column-gap: var(--spacing-lg);
		row-gap: var(--spacing-md);
		margin-top: var(--spacing-3xl);
		padding-top: var(--spacing-xl);
		border-top: 1px solid var(--color-border-on-dark);
	}
	.zakres__stack-label {
		font-size: 0.75em;
		font-weight: var(--weight-emphasis);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-on-dark-muted);
		white-space: nowrap;
	}
	.zakres__stack-list { display: flex; flex-wrap: wrap; align-items: center; gap: var(--spacing-md); list-style: none; }
	.zakres__stack-list li {
		font-family: var(--font-heading);
		font-size: 1.125em;
		font-weight: var(--weight-heading);
		color: var(--color-text-on-dark);
	}
	.zakres__stack-list li + li::before { content: "·"; margin-right: var(--spacing-md); color: var(--accent-brand); }
	.zakres__stack-note {
		grid-column: 2;
		max-width: 46em;
		font-size: var(--text-sm);
		line-height: 1.6;
		color: var(--color-text-on-dark-muted);
	}

	@media screen and (max-width: 991px) {
		.zakres__spec { grid-template-columns: 1fr; }
		.zakres__stack { grid-template-columns: 1fr; }
		.zakres__stack-note { grid-column: 1; }
	}
	@media screen and (max-width: 767px) {
		.zakres__outer { padding-block: var(--spacing-4xl); }
		.zakres__row { padding-block: var(--spacing-lg); }
		.zakres__label { grid-template-columns: 2.2em minmax(0, 1fr); font-size: 1.125em; }
		.zakres__desc { padding-left: 2.7em; }
	}
</style>
