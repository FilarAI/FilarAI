---
// PrzedPo — sekcja "przed / po" z nagłówkiem. Cienki konsument PrzedPoSlider.
// Sam mechanizm slidera (markup + CSS + script) mieszka w PrzedPoSlider.astro.
//
// Obrazy: wrzuć screeny do public/strony/ jako `przed.jpg` i `po.jpg` i podmień defaulty.
// Proporcje sceny trzyma `ratio` — dostosuj do screenów.

import PrzedPoSlider from "./PrzedPoSlider.astro";

interface Props {
	beforeSrc?: string;
	afterSrc?: string;
	ratio?: string;
}

const {
	beforeSrc = "/strony/przed.svg",
	afterSrc = "/strony/po.svg",
	ratio = "16 / 10",
} = Astro.props;
---

<section class="ppo section--light">
	<div class="ppo__outer">
		<div class="ppo__header">
			<p class="ppo__eyebrow"><i aria-hidden="true"></i><b>Przed / po</b><span>/</span> realna metamorfoza</p>
			<h2 class="ppo__title">Przeciągnij i zobacz różnicę.</h2>
			<p class="ppo__subtitle">Ta sama firma, ta sama oferta — inna strona. Po lewej stan wyjściowy, po prawej wersja, która zaczęła przynosić zapytania.</p>
		</div>

		<PrzedPoSlider beforeSrc={beforeSrc} afterSrc={afterSrc} ratio={ratio} />
	</div>
</section>

<style>
	.ppo__outer {
		max-width: var(--size-container);
		margin-inline: auto;
		padding-inline: var(--container-padding);
		padding-block: var(--spacing-section);
	}

	.ppo__header { max-width: 40em; margin-bottom: var(--spacing-2xl); }
	.ppo__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.65em;
		font-size: 0.75em;
		font-weight: var(--weight-emphasis);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--color-text-secondary);
	}
	.ppo__eyebrow i { width: 0.55em; height: 0.55em; border-radius: 50%; background-color: var(--accent-brand); }
	.ppo__eyebrow b { color: var(--color-contrast); }
	.ppo__eyebrow > span { color: var(--accent-brand); }
	.ppo__title {
		margin-top: var(--spacing-lg);
		font-family: var(--font-heading);
		font-size: var(--text-h2);
		font-weight: var(--weight-heading);
		line-height: var(--lh-heading);
		letter-spacing: -1px;
		color: var(--color-contrast);
	}
	.ppo__subtitle { margin-top: var(--spacing-md); font-size: var(--text-lead); line-height: var(--lh-lead); color: var(--color-text-secondary); }
</style>
