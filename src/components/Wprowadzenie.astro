---
// Wprowadzenie — sekcja "Jak to działa" (między LogoStrip a Ofertą).
// Diagram zbieżności: kanały (chaos) → hub (system FilarAI) → wyniki.
// Tożsamość ciepło+oliwka; struktura wzorowana na zaakceptowanej wizualizacji.
//
// Ikony monochromatyczne (currentColor), w .icon-tile z global.css.
// WhatsApp/Meta w rozpoznawalnym kształcie marki, ale oliwkowe — nie pełne kolory.

interface Channel {
	label: string;
	icon: string;
}

interface OrbitAction {
	label: string;
	icon: string;
	pos: "top" | "right" | "bottom" | "left";
}

interface Outcome {
	title: string;
	desc: string;
	icon: string;
}

const icon = {
	form: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>`,
	whatsapp: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 0 0-7.7 13.7L3 21l4.5-1.2A9 9 0 1 0 12 3z"/><path d="M8.9 8.4c-.2 0-.5 0-.7.3-.3.3-.9.9-.9 2.1s.9 2.4 1 2.5c.2.2 1.8 2.8 4.3 3.8 2.1.8 2.5.7 3 .6.5 0 1.5-.6 1.7-1.2.2-.6.2-1 .1-1.1-.1-.1-.3-.2-.5-.3l-1.5-.7c-.2-.1-.4-.1-.5.1l-.6.7c-.1.2-.3.2-.5.1-.7-.3-1.4-.7-1.9-1.5-.2-.2 0-.4.1-.5l.4-.5c.1-.2.1-.3 0-.5l-.6-1.6c-.2-.4-.4-.4-.6-.4z"/></svg>`,
	social: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 10.5l6.8-4M8.6 13.5l6.8 4"/></svg>`,
	phone: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h3l1.5 5-2 1.5a11 11 0 0 0 5 5l1.5-2 5 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 5.2 2 2 0 0 1 6 3z"/></svg>`,
	mail: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 6.5 12 13l8.5-6.5"/></svg>`,

	inbox: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16v9H8l-4 4z"/><path d="M8 10h8"/></svg>`,
	question: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9.5 9.2a2.5 2.5 0 1 1 3.6 2.3c-.8.4-1.1.9-1.1 1.8v.4"/><circle cx="12" cy="16.6" r="0.7" fill="currentColor" stroke="none"/></svg>`,
	bolt: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7z"/></svg>`,
	loop: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.6-5.9"/><path d="M20 4v5h-5"/></svg>`,

	clock: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/></svg>`,
	calendar: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="5" width="16" height="16" rx="2"/><path d="M4 9h16M8 3v4M16 3v4"/><path d="M9 14.5l2 2 4-4.5"/></svg>`,
	trend: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17l5-5 4 4 7-8"/><path d="M14 8h6v6"/></svg>`,

	cross: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>`,
	check: `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>`,
};

const channels: Channel[] = [
	{ label: "Formularz na stronie", icon: icon.form },
	{ label: "WhatsApp", icon: icon.whatsapp },
	{ label: "Social media", icon: icon.social },
	{ label: "Telefon / SMS", icon: icon.phone },
	{ label: "E-mail", icon: icon.mail },
];

const orbit: OrbitAction[] = [
	{ label: "Odbiera kontakt", icon: icon.inbox, pos: "top" },
	{ label: "Odpowiada automatycznie", icon: icon.bolt, pos: "right" },
	{ label: "Pilnuje follow-upu", icon: icon.loop, pos: "bottom" },
	{ label: "Zadaje pytania", icon: icon.question, pos: "left" },
];

const outcomes: Outcome[] = [
	{
		title: "Szybka odpowiedź",
		desc: "Klient dostaje odpowiedź w kilka minut, nie godzin.",
		icon: icon.clock,
	},
	{
		title: "Zapis do kalendarza",
		desc: "System sam umawia i wpisuje rozmowę do kalendarza.",
		icon: icon.calendar,
	},
	{
		title: "Więcej klientów",
		desc: "Mniej zgubionych zapytań, więcej podpisanych umów.",
		icon: icon.trend,
	},
];
---

<section class="wprow section--light">
	<div class="wprow__outer">
		<div class="wprow__eyebrow">
			<span class="wprow__eyebrow-dot" aria-hidden="true"></span>
			Systemy, które pracują
		</div>

		<h2 class="wprow__title">
			Strona zbiera zapytania.<br />
			<span class="wprow__accent">System zamienia je w rozmowy.</span>
		</h2>

		<p class="wprow__subtitle">
			Zapytania trafiają do systemu, który odpowiada, pilnuje follow-upu i pomaga zamieniać
			kontakt w realnego klienta.
		</p>

		<div class="wprow__panel">
			<div class="wprow__labels" aria-hidden="true">
				<span>Skąd wpadają zapytania</span>
				<span>Co robi system</span>
				<span>Co zyskujesz</span>
			</div>

			<div class="wprow__stage">
				{/* Łączniki — dekoracja. viewBox 0-100 + preserveAspectRatio none, stroke
				    trzymany na stałej grubości przez vector-effect. Ukryte na mobile.
				    Każda ścieżka ma id, żeby kropka mogła po niej biec (animateMotion + mpath). */}
				<svg
					class="wprow__wires"
					viewBox="0 0 100 100"
					preserveAspectRatio="none"
					aria-hidden="true"
				>
					{/* fan-in: 5 kanałów → środek ikony orbity `left` (question mark).
					    Węzły są wyżej niż środek całego stage, bo pod hubem jest lista akcji. */}
					<path id="wp-in-1" class="wprow__wire" d="M25 10 C30 10 32 38 37.75 38" />
					<path id="wp-in-2" class="wprow__wire" d="M25 30 C32 30 34 38 37.75 38" />
					<path id="wp-in-3" class="wprow__wire" d="M25 50 C32 50 34 38 37.75 38" />
					<path id="wp-in-4" class="wprow__wire" d="M25 70 C32 70 34 38 37.75 38" />
					<path id="wp-in-5" class="wprow__wire" d="M25 90 C30 90 32 38 37.75 38" />
					{/* fan-out: środek ikony orbity `right` (bolt) → 3 wyniki */}
					<path id="wp-out-1" class="wprow__wire" d="M62.25 38 C67 38 67 22 75 22" />
					<path id="wp-out-2" class="wprow__wire" d="M62.25 38 C67 38 69 50 75 50" />
					<path id="wp-out-3" class="wprow__wire" d="M62.25 38 C67 38 67 78 75 78" />
				</svg>

				{/* Kropki płynące — realizowane przez sunący stroke-dashoffset na
				    liniach, nie przez <circle animateMotion>. Powód: wire-svg ma
				    preserveAspectRatio="none" (linie muszą się rozciągać na cały
				    panel), a to zdeformowałoby kółka do elips. Dashoffset nie
				    zależy od aspect ratio i daje ten sam wizualny efekt "przepływu". */}

				<div class="wprow__cols">
					{/* LEWA — kanały */}
					<ul class="wprow__channels">
						{
							channels.map((c) => (
								<li class="wprow__channel">
									<span class="icon-tile wprow__channel-tile" set:html={c.icon} />
									<span class="wprow__channel-label">{c.label}</span>
								</li>
							))
						}
					</ul>

					{/* ŚRODEK — kolumna: hub-wrap (z 4 ikonami orbity dookoła) + lista 2×2
					    POD hub-wrap (pod dolną ikoną orbity). */}
					<div class="wprow__hub-block">
						<div class="wprow__hub-wrap">
							<span class="atmo-glow wprow__hub-glow" aria-hidden="true"></span>

							<svg
								class="wprow__orbit-svg"
								viewBox="0 0 100 100"
								preserveAspectRatio="none"
								aria-hidden="true"
							>
								<circle class="wprow__orbit-ring" cx="50" cy="50" r="42" fill="none" />
							</svg>

							{
								orbit.map((a) => (
									<span class={`wprow__orbit-icon wprow__orbit-icon--${a.pos}`} set:html={a.icon} />
								))
							}

							<div class="wprow__hub">
								<span class="wprow__hub-mark" role="img" aria-label="FilarAI"></span>
							</div>
						</div>

						<ul class="wprow__actions">
							{
								orbit.map((a) => (
									<li class="wprow__action">
										<span class="icon-tile wprow__action-tile" set:html={a.icon} />
										{a.label}
									</li>
								))
							}
						</ul>
					</div>

					{/* PRAWA — wyniki */}
					<ul class="wprow__outcomes">
						{
							outcomes.map((o) => (
								<li class="wprow__outcome">
									<span class="icon-tile wprow__outcome-tile" set:html={o.icon} />
									<div class="wprow__outcome-body">
										<p class="wprow__outcome-title">{o.title}</p>
										<p class="wprow__outcome-desc">{o.desc}</p>
									</div>
								</li>
							))
						}
					</ul>
				</div>
			</div>

			{/* DÓŁ — przed → po, w palecie */}
			<div class="wprow__compare">
				<div class="wprow__compare-side">
					<span class="wprow__compare-tile wprow__compare-tile--bad" set:html={icon.cross} />
					<p class="wprow__compare-text">
						<strong>Bez systemu:</strong> wolna reakcja, ręczne odpisywanie, zgubione zapytania.
					</p>
				</div>
				<span class="wprow__compare-divider" aria-hidden="true"></span>
				<div class="wprow__compare-side">
					<span class="wprow__compare-tile wprow__compare-tile--good" set:html={icon.check} />
					<p class="wprow__compare-text">
						<strong>Z systemem:</strong> odpowiedź w kilka minut, follow-up, więcej umówionych
						rozmów.
					</p>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.wprow {
		background-color: var(--color-canvas);
	}

	.wprow__outer {
		max-width: var(--size-container);
		margin-inline: auto;
		padding-inline: var(--container-padding);
		padding-block: var(--spacing-section);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
	}

	/* ===== Eyebrow ===== */

	.wprow__eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.5em 1em;
		font-family: var(--font-body);
		font-size: 0.8125em;
		font-weight: 600;
		letter-spacing: 2px;
		text-transform: uppercase;
		color: var(--accent-deep);
		background-color: var(--color-canvas);
		border: 1px solid var(--color-border);
		border-radius: 999em;
	}

	.wprow__eyebrow-dot {
		width: 0.5em;
		height: 0.5em;
		border-radius: 50%;
		background-color: var(--accent-brand);
	}

	/* ===== Nagłówek ===== */

	.wprow__title {
		margin-top: 1.25em;
		font-family: var(--font-heading);
		font-size: var(--text-h2);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -1.5px;
		color: var(--color-contrast);
		max-width: 20em;
	}

	.wprow__accent {
		color: var(--accent-deep);
	}

	.wprow__subtitle {
		margin-top: 1em;
		max-width: 44em;
		font-size: var(--text-lead);
		line-height: var(--lh-lead);
		color: var(--color-text-secondary);
	}

	/* ===== Panel ===== */

	.wprow__panel {
		width: 100%;
		max-width: 90em; /* szerszy diagram — kreski dochodzą do ikon orbity, nie do węzłów przy hubie */
		margin-top: 3.5em;
		padding: 3em 3.5em;
		background-color: var(--color-canvas);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-lg);
		box-shadow: var(--elevation-1);
	}

	.wprow__labels {
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		gap: 2em;
		margin-bottom: 1.5em;
		text-align: left;
	}

	.wprow__labels span {
		font-size: 0.75em;
		font-weight: 600;
		letter-spacing: 1.5px;
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.wprow__labels span:nth-child(2) {
		text-align: center;
	}
	.wprow__labels span:nth-child(3) {
		text-align: right;
	}

	/* ===== Stage (kolumny + łączniki) ===== */

	.wprow__stage {
		position: relative;
	}

	.wprow__wires {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 0;
	}

	.wprow__wire {
		fill: none;
		stroke: var(--accent-brand);
		stroke-width: 1.5;
		stroke-dasharray: 2 4.5;
		stroke-linecap: round;
		opacity: 0.55;
		vector-effect: non-scaling-stroke;
		/* Przepływ przez sunący dashoffset. dur zgodny z kierunkiem ścieżki
		   (ujemny offset = do przodu w kierunku narysowania). Fan-in narysowany
		   od kanału do huba → dashes płyną do huba. Fan-out odwrotnie. */
		animation: wprow-flow 1.1s linear infinite;
	}

	.wprow__cols {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 3em; /* było 2em — dłuższe łączniki */
	}

	/* ===== Lewa — kanały ===== */

	.wprow__channels {
		display: flex;
		flex-direction: column;
		gap: 0.75em;
		list-style: none;
	}

	.wprow__channel {
		display: flex;
		align-items: center;
		gap: 0.875em;
		padding: 0.75em 1em;
		background-color: var(--color-canvas);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--elevation-1);
		text-align: left;
	}

	.wprow__channel-tile {
		width: 2.25em;
		height: 2.25em;
	}

	.wprow__channel-tile svg {
		width: 1.25em;
		height: 1.25em;
	}

	.wprow__channel-label {
		font-family: var(--font-heading);
		font-size: 1em;
		font-weight: 600;
		color: var(--color-contrast);
	}

	/* ===== Środek — hub-block: hub-wrap na górze + lista 2×2 pod spodem ===== */

	.wprow__hub-block {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.25em;
	}

	/* Zwarta, niemal okrągła orbita — jej środek jest wspólny z hubem, a cztery
	   ikony siedzą dokładnie na pierścieniu. Taka proporcja odpowiada referencji
	   i sprawia, że łączniki trafiają w `?` oraz błyskawicę, nie obok nich. */
	.wprow__hub-wrap {
		--orbit-rx: 9.24em;
		--orbit-ry: 7.77em;
		position: relative;
		width: 22em;
		height: 18.5em;
		display: grid;
		place-items: center;
	}

	.wprow__hub-glow {
		width: 24em;
		height: 16em;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		/* Puls tylko na opacity — transform trzyma centrowanie, nie ruszamy go. */
		animation: wprow-glow 4s ease-in-out infinite;
	}

	.wprow__orbit-svg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		z-index: 1;
		overflow: visible;
	}

	.wprow__orbit-ring {
		stroke: var(--color-border);
		stroke-width: 1;
		stroke-dasharray: 2 4;
		vector-effect: non-scaling-stroke;
		opacity: 0.9;
	}

	.wprow__hub {
		position: relative;
		z-index: 2;
		display: grid;
		place-items: center;
		width: 6.5em;
		height: 6.5em;
		background-color: var(--color-canvas);
		border-radius: var(--radius-lg);
		box-shadow: var(--elevation-3);
	}

	.wprow__hub-mark {
		width: 2.5em;
		height: 3em;
		background-color: var(--color-contrast);
		-webkit-mask: url(/logo/filar-ai-mark-white.svg) center / contain no-repeat;
		mask: url(/logo/filar-ai-mark-white.svg) center / contain no-repeat;
	}

	/* 4 ikony NA pierścieniu — bez etykiet przy sobie (te są osobno, w
	   .wprow__actions pod hubem). Pozycje korzystają z tych samych promieni,
	   co SVG ring, więc nie rozjadą się przy późniejszym strojeniu orbity. */
	.wprow__orbit-icon {
		position: absolute;
		z-index: 2;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.5em;
		height: 2.5em;
		border-radius: 0.75em;
		background-color: var(--color-canvas);
		border: 1px solid var(--color-border);
		color: var(--accent-deep);
		box-shadow: var(--elevation-1);
	}

	.wprow__orbit-icon svg {
		width: 1.25em;
		height: 1.25em;
	}

	/* Elipsa 22em × 18.5em → rx = 9.24em, ry = 7.77em (42% każdej osi). */
	.wprow__orbit-icon--top {
		top: 50%;
		left: 50%;
		transform: translate(-50%, calc(-50% - var(--orbit-ry)));
	}
	.wprow__orbit-icon--bottom {
		top: 50%;
		left: 50%;
		transform: translate(-50%, calc(-50% + var(--orbit-ry)));
	}
	.wprow__orbit-icon--left {
		top: 50%;
		left: 50%;
		transform: translate(calc(-50% - var(--orbit-rx)), -50%);
	}
	.wprow__orbit-icon--right {
		top: 50%;
		left: 50%;
		transform: translate(calc(-50% + var(--orbit-rx)), -50%);
	}

	/* Lista akcji — 2×2 siatka POD hub-wrap (pod dolną ikoną orbity). */
	.wprow__actions {
		display: grid;
		grid-template-columns: repeat(2, auto);
		gap: 0.75em 2em;
		list-style: none;
	}

	.wprow__action {
		display: flex;
		align-items: center;
		gap: 0.75em;
		font-size: 0.9375em;
		font-weight: 600;
		line-height: 1.2;
		color: var(--color-contrast);
		white-space: nowrap;
	}

	/* Kafel-ikona (bazowo .icon-tile z global.css: 2.75em). Tu mniejszy,
	   dopasowany do skali listy pod hubem. */
	.wprow__action-tile {
		width: 2em;
		height: 2em;
		border-radius: 0.5em;
	}

	.wprow__action-tile svg {
		width: 1em;
		height: 1em;
	}

	/* ===== Prawa — wyniki ===== */

	.wprow__outcomes {
		display: flex;
		flex-direction: column;
		gap: 0.75em;
		list-style: none;
	}

	.wprow__outcome {
		display: flex;
		align-items: flex-start;
		gap: 0.875em;
		padding: 1em 1.125em;
		background-color: var(--color-canvas);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-md);
		box-shadow: var(--elevation-1);
		text-align: left;
		transition:
			transform var(--transition-base),
			box-shadow var(--transition-base);
	}

	.wprow__outcome:hover {
		transform: translateY(-2px);
		box-shadow: var(--elevation-2);
	}

	.wprow__outcome-tile {
		width: 2.5em;
		height: 2.5em;
	}

	.wprow__outcome-tile svg {
		width: 1.25em;
		height: 1.25em;
	}

	.wprow__outcome-title {
		font-family: var(--font-heading);
		font-size: 1.0625em;
		font-weight: 700;
		color: var(--color-contrast);
	}

	.wprow__outcome-desc {
		margin-top: 0.15em;
		font-size: 0.9375em;
		line-height: 1.4;
		color: var(--color-text-secondary);
	}

	/* ===== Dół — przed → po ===== */

	.wprow__compare {
		display: grid;
		grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
		align-items: center;
		gap: 2em;
		margin-top: 2.5em;
		padding-top: 2em;
		border-top: 1px solid var(--color-border);
	}

	.wprow__compare-side {
		display: flex;
		align-items: center;
		gap: 1em;
		text-align: left;
	}

	.wprow__compare-tile {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 2.75em;
		height: 2.75em;
		flex-shrink: 0;
		border-radius: var(--radius-md);
	}

	.wprow__compare-tile svg {
		width: 1.375em;
		height: 1.375em;
	}

	/* "bez" — neutralny szary, nie czerwony (dyscyplina palety) */
	.wprow__compare-tile--bad {
		background-color: var(--color-atmosphere);
		color: var(--color-text-muted);
	}

	.wprow__compare-tile--good {
		background-color: var(--accent-wash);
		color: var(--accent-deep);
	}

	.wprow__compare-text {
		font-size: 0.9375em;
		line-height: 1.45;
		color: var(--color-text-secondary);
	}

	.wprow__compare-text strong {
		font-weight: 700;
		color: var(--color-contrast);
	}

	.wprow__compare-divider {
		width: 1px;
		align-self: stretch;
		background-color: var(--color-border);
	}

	/* ===== Responsywność ===== */

	@media screen and (max-width: 991px) {
		.wprow__wires {
			display: none;
		}

		.wprow__labels {
			display: none;
		}

		.wprow__cols {
			grid-template-columns: minmax(0, 1fr);
			gap: 3em;
			max-width: 26em;
			margin-inline: auto;
		}

		/* Mobile: piżon orbity (dekoracyjny okrąg, poświata, 4 ikony wokół)
		   nie mieści się czytelnie w wąskiej stackowanej kolumnie — ukrywamy,
		   zostaje sam hub + lista pod nim. */
		.wprow__hub-wrap {
			width: auto;
			height: auto;
			display: block;
		}

		.wprow__hub-glow,
		.wprow__orbit-svg,
		.wprow__orbit-icon {
			display: none;
		}
	}

	@media screen and (max-width: 767px) {
		.wprow__panel {
			padding: 1.5em;
		}

		.wprow__hub {
			width: 5.5em;
			height: 5.5em;
		}

		.wprow__hub-mark {
			width: 2.125em;
			height: 2.55em;
		}

		/* Dwie kolumny są za ciasne na "Odpowiada automatycznie" przy wąskim
		   ekranie — jedna kolumna, wypunktowana lista. */
		.wprow__actions {
			grid-template-columns: 1fr;
			gap: 0.5em;
			text-align: left;
		}

		.wprow__compare {
			grid-template-columns: minmax(0, 1fr);
			gap: 1.25em;
		}

		.wprow__compare-divider {
			width: 100%;
			height: 1px;
		}
	}

	/* ===== Animacje ===== */

	@keyframes wprow-flow {
		to {
			stroke-dashoffset: -6.5;
		}
	}

	@keyframes wprow-glow {
		0%,
		100% {
			opacity: 0.6;
		}
		50% {
			opacity: 1;
		}
	}

	/* Reveal przy wejściu w viewport. Stan początkowy (ukryty) TYLKO gdy JS ustawi
	   [data-animate] — bez JS treść jest normalnie widoczna. */
	.wprow[data-animate="true"] .wprow__channel,
	.wprow[data-animate="true"] .wprow__hub-block,
	.wprow[data-animate="true"] .wprow__outcome,
	.wprow[data-animate="true"] .wprow__compare {
		opacity: 0;
		transform: translateY(1em);
		transition:
			opacity 600ms ease,
			transform 600ms ease;
	}

	.wprow[data-visible="true"] .wprow__channel,
	.wprow[data-visible="true"] .wprow__hub-block,
	.wprow[data-visible="true"] .wprow__outcome,
	.wprow[data-visible="true"] .wprow__compare {
		opacity: 1;
		transform: translateY(0);
	}

	/* Stagger — kanały, potem hub, potem wyniki */
	.wprow[data-animate="true"] .wprow__channel:nth-child(2) {
		transition-delay: 70ms;
	}
	.wprow[data-animate="true"] .wprow__channel:nth-child(3) {
		transition-delay: 140ms;
	}
	.wprow[data-animate="true"] .wprow__channel:nth-child(4) {
		transition-delay: 210ms;
	}
	.wprow[data-animate="true"] .wprow__channel:nth-child(5) {
		transition-delay: 280ms;
	}
	.wprow[data-animate="true"] .wprow__hub-block {
		transition-delay: 180ms;
	}
	.wprow[data-animate="true"] .wprow__outcome:nth-child(2) {
		transition-delay: 320ms;
	}
	.wprow[data-animate="true"] .wprow__outcome:nth-child(3) {
		transition-delay: 390ms;
	}
	.wprow[data-animate="true"] .wprow__outcome:nth-child(1) {
		transition-delay: 250ms;
	}

	@media (prefers-reduced-motion: reduce) {
		.wprow__outcome {
			transition: none;
		}
		.wprow__outcome:hover {
			transform: none;
		}
		.wprow__hub-glow,
		.wprow__wire {
			animation: none;
		}
	}
</style>

<script>
	// Reveal — włączamy stan animacji tylko gdy user nie prosił o mniej ruchu.
	// Bez JS / z reduced-motion sekcja jest od razu widoczna (żaden [data-animate]).
	const wprow = document.querySelector<HTMLElement>(".wprow");
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (wprow && !reduced) {
		wprow.dataset.animate = "true";
		const io = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						wprow.dataset.visible = "true";
						io.disconnect();
						break;
					}
				}
			},
			{ threshold: 0.2 },
		);
		io.observe(wprow);
	}
</script>
